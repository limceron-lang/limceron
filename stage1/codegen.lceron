// ── Expression Code Generation ──────────────────────────────
// emit_expr returns the C code string for an expression node.
// svars tracks string variables for concat detection.

fn emit_expr(svars: string, node: string) -> string {
    let tag = node_tag(node, 0)
    let out = sb_new()

    if str_eq(tag, "int") {
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let val = read_word(node, p)
        sb_append(out, val)

    } else if str_eq(tag, "float") {
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let val = read_word(node, p)
        sb_append(out, val)

    } else if str_eq(tag, "bool") {
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let val = read_word(node, p)
        sb_append(out, val)

    } else if str_eq(tag, "none") {
        sb_append(out, "NULL")

    } else if str_eq(tag, "string") {
        // (string "content")
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        // Should be at the opening "
        if p < str_len(node) {
            if char_code(char_at(node, p)) == 34 {
                let content = read_quoted(node, p)
                sb_append(out, "\"")
                // Escape the content for C
                // Note: escape sequences like \t, \n from the source are stored
                // as literal backslash+char in the AST. We must pass them through
                // to C rather than double-escaping.
                let ci = 0
                let clen = str_len(content)
                for _ce in 0..100000 {
                    if ci >= clen { break }
                    let ch = char_at(content, ci)
                    let cc = char_code(ch)
                    if cc == 10 {
                        sb_append(out, "\\n")
                    } else if cc == 13 {
                        sb_append(out, "\\r")
                    } else if cc == 9 {
                        sb_append(out, "\\t")
                    } else if cc == 92 {
                        // Backslash: check if it's an escape sequence from source
                        if ci + 1 < clen {
                            let next_ch = char_at(content, ci + 1)
                            let nc = char_code(next_ch)
                            if nc == 110 {
                                // \n — pass through
                                sb_append(out, "\\n")
                                ci = ci + 1
                            } else if nc == 116 {
                                // \t — pass through
                                sb_append(out, "\\t")
                                ci = ci + 1
                            } else if nc == 114 {
                                // \r — pass through
                                sb_append(out, "\\r")
                                ci = ci + 1
                            } else if nc == 92 {
                                // \\ — pass through
                                sb_append(out, "\\\\")
                                ci = ci + 1
                            } else if nc == 34 {
                                // \" — pass through
                                sb_append(out, "\\\"")
                                ci = ci + 1
                            } else if nc == 48 {
                                // \0 — pass through
                                sb_append(out, "\\0")
                                ci = ci + 1
                            } else {
                                // Unknown escape, just emit backslash
                                sb_append(out, "\\\\")
                            }
                        } else {
                            sb_append(out, "\\\\")
                        }
                    } else if cc == 34 {
                        sb_append(out, "\\\"")
                    } else {
                        sb_append(out, ch)
                    }
                    ci = ci + 1
                }
                sb_append(out, "\"")
            } else {
                // No quote found, just grab word
                let val = read_word(node, p)
                sb_append(out, "\"")
                sb_append(out, val)
                sb_append(out, "\"")
            }
        }

    } else if str_eq(tag, "ident") {
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let name = read_word(node, p)
        sb_append(out, name)

    } else if str_eq(tag, "neg") {
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let inner = child_at(node, p)
        sb_append(out, "-(")
        sb_append(out, emit_expr(svars, inner))
        sb_append(out, ")")

    } else if str_eq(tag, "not") {
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let inner = child_at(node, p)
        sb_append(out, "!(")
        sb_append(out, emit_expr(svars, inner))
        sb_append(out, ")")

    } else if str_eq(tag, "+") {
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let left = child_at(node, p)
        p = skip_child(node, p)
        p = skip_ws(node, p)
        let right = child_at(node, p)
        // Check for string concat
        if might_be_string(svars, left) {
            sb_append(out, "lcn_str_concat(")
            sb_append(out, emit_expr(svars, left))
            sb_append(out, ", ")
            sb_append(out, emit_expr(svars, right))
            sb_append(out, ")")
        } else if might_be_string(svars, right) {
            sb_append(out, "lcn_str_concat(")
            sb_append(out, emit_expr(svars, left))
            sb_append(out, ", ")
            sb_append(out, emit_expr(svars, right))
            sb_append(out, ")")
        } else {
            sb_append(out, "(")
            sb_append(out, emit_expr(svars, left))
            sb_append(out, " + ")
            sb_append(out, emit_expr(svars, right))
            sb_append(out, ")")
        }

    } else if str_eq(tag, "-") {
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let left = child_at(node, p)
        p = skip_child(node, p)
        p = skip_ws(node, p)
        let right = child_at(node, p)
        sb_append(out, "(")
        sb_append(out, emit_expr(svars, left))
        sb_append(out, " - ")
        sb_append(out, emit_expr(svars, right))
        sb_append(out, ")")

    } else if str_eq(tag, "*") {
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let left = child_at(node, p)
        p = skip_child(node, p)
        p = skip_ws(node, p)
        let right = child_at(node, p)
        sb_append(out, "(")
        sb_append(out, emit_expr(svars, left))
        sb_append(out, " * ")
        sb_append(out, emit_expr(svars, right))
        sb_append(out, ")")

    } else if str_eq(tag, "/") {
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let left = child_at(node, p)
        p = skip_child(node, p)
        p = skip_ws(node, p)
        let right = child_at(node, p)
        sb_append(out, "(")
        sb_append(out, emit_expr(svars, left))
        sb_append(out, " / ")
        sb_append(out, emit_expr(svars, right))
        sb_append(out, ")")

    } else if str_eq(tag, "==") {
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let left = child_at(node, p)
        p = skip_child(node, p)
        p = skip_ws(node, p)
        let right = child_at(node, p)
        // String equality → strcmp
        if might_be_string(svars, left) {
            sb_append(out, "(strcmp(")
            sb_append(out, emit_expr(svars, left))
            sb_append(out, ", ")
            sb_append(out, emit_expr(svars, right))
            sb_append(out, ") == 0)")
        } else if might_be_string(svars, right) {
            sb_append(out, "(strcmp(")
            sb_append(out, emit_expr(svars, left))
            sb_append(out, ", ")
            sb_append(out, emit_expr(svars, right))
            sb_append(out, ") == 0)")
        } else {
            sb_append(out, "(")
            sb_append(out, emit_expr(svars, left))
            sb_append(out, " == ")
            sb_append(out, emit_expr(svars, right))
            sb_append(out, ")")
        }

    } else if str_eq(tag, "!=") {
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let left = child_at(node, p)
        p = skip_child(node, p)
        p = skip_ws(node, p)
        let right = child_at(node, p)
        if might_be_string(svars, left) {
            sb_append(out, "(strcmp(")
            sb_append(out, emit_expr(svars, left))
            sb_append(out, ", ")
            sb_append(out, emit_expr(svars, right))
            sb_append(out, ") != 0)")
        } else if might_be_string(svars, right) {
            sb_append(out, "(strcmp(")
            sb_append(out, emit_expr(svars, left))
            sb_append(out, ", ")
            sb_append(out, emit_expr(svars, right))
            sb_append(out, ") != 0)")
        } else {
            sb_append(out, "(")
            sb_append(out, emit_expr(svars, left))
            sb_append(out, " != ")
            sb_append(out, emit_expr(svars, right))
            sb_append(out, ")")
        }

    } else if str_eq(tag, "<") {
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let left = child_at(node, p)
        p = skip_child(node, p)
        p = skip_ws(node, p)
        let right = child_at(node, p)
        sb_append(out, "(")
        sb_append(out, emit_expr(svars, left))
        sb_append(out, " < ")
        sb_append(out, emit_expr(svars, right))
        sb_append(out, ")")

    } else if str_eq(tag, ">") {
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let left = child_at(node, p)
        p = skip_child(node, p)
        p = skip_ws(node, p)
        let right = child_at(node, p)
        sb_append(out, "(")
        sb_append(out, emit_expr(svars, left))
        sb_append(out, " > ")
        sb_append(out, emit_expr(svars, right))
        sb_append(out, ")")

    } else if str_eq(tag, "<=") {
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let left = child_at(node, p)
        p = skip_child(node, p)
        p = skip_ws(node, p)
        let right = child_at(node, p)
        sb_append(out, "(")
        sb_append(out, emit_expr(svars, left))
        sb_append(out, " <= ")
        sb_append(out, emit_expr(svars, right))
        sb_append(out, ")")

    } else if str_eq(tag, ">=") {
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let left = child_at(node, p)
        p = skip_child(node, p)
        p = skip_ws(node, p)
        let right = child_at(node, p)
        sb_append(out, "(")
        sb_append(out, emit_expr(svars, left))
        sb_append(out, " >= ")
        sb_append(out, emit_expr(svars, right))
        sb_append(out, ")")

    } else if str_eq(tag, "|>") {
        // Pipe: a |> b  →  b(a)
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let left = child_at(node, p)
        p = skip_child(node, p)
        p = skip_ws(node, p)
        let right = child_at(node, p)
        sb_append(out, emit_expr(svars, right))
        sb_append(out, "(")
        sb_append(out, emit_expr(svars, left))
        sb_append(out, ")")

    } else if str_eq(tag, "call") {
        // (call name arg1 arg2 ...)
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let fname = read_word(node, p)
        p = p + str_len(fname)
        // Collect arguments
        let args = sb_new()
        let arg_count = 0
        let nlen = str_len(node)
        for _ca in 0..100 {
            p = skip_ws(node, p)
            if p >= nlen - 1 { break }
            if char_code(char_at(node, p)) == 41 { break }
            let arg_node = child_at(node, p)
            if str_len(arg_node) == 0 { break }
            if arg_count > 0 {
                sb_append(args, "\t")
            }
            sb_append(args, emit_expr(svars, arg_node))
            arg_count = arg_count + 1
            p = skip_child(node, p)
        }
        let arg_str = sb_to_string(args)
        // Split args by tab
        // Emit based on function name
        if str_eq(fname, "println") {
            sb_append(out, "printf(\"%s\\n\", ")
            if arg_count > 0 {
                // First arg
                let tab = str_find(arg_str, "\t")
                if tab < 0 {
                    sb_append(out, arg_str)
                } else {
                    sb_append(out, str_slice(arg_str, 0, tab))
                }
            } else {
                sb_append(out, "\"\"")
            }
            sb_append(out, ")")
        } else if str_eq(fname, "print") {
            sb_append(out, "printf(\"%s\", ")
            if arg_count > 0 {
                let tab = str_find(arg_str, "\t")
                if tab < 0 {
                    sb_append(out, arg_str)
                } else {
                    sb_append(out, str_slice(arg_str, 0, tab))
                }
            } else {
                sb_append(out, "\"\"")
            }
            sb_append(out, ")")
        } else if str_eq(fname, "len") {
            sb_append(out, "(int64_t)strlen(")
            sb_append(out, emit_arg(arg_str, 0))
            sb_append(out, ")")
        } else if str_eq(fname, "str_len") {
            sb_append(out, "(int64_t)strlen(")
            sb_append(out, emit_arg(arg_str, 0))
            sb_append(out, ")")
        } else if str_eq(fname, "str_eq") {
            sb_append(out, "(strcmp(")
            sb_append(out, emit_arg(arg_str, 0))
            sb_append(out, ", ")
            sb_append(out, emit_arg(arg_str, 1))
            sb_append(out, ") == 0)")
        } else if str_eq(fname, "str_find") {
            sb_append(out, "lcn_str_find(")
            sb_append(out, emit_arg(arg_str, 0))
            sb_append(out, ", ")
            sb_append(out, emit_arg(arg_str, 1))
            sb_append(out, ")")
        } else if str_eq(fname, "str_slice") {
