            sb_append(out, "lcn_fits_in_budget(")
            sb_append(out, emit_arg(arg_str, 0))
            sb_append(out, ", ")
            sb_append(out, emit_arg(arg_str, 1))
            sb_append(out, ")")
        // ── Other builtins ──
        } else if str_eq(fname, "driver") {
            sb_append(out, "lcn_driver_init(")
            sb_append(out, emit_arg(arg_str, 0))
            sb_append(out, ")")
        } else if str_eq(fname, "vec_pop") {
            sb_append(out, "lcn_vec_pop(&")
            sb_append(out, emit_arg(arg_str, 0))
            sb_append(out, ")")
        } else {
            // User-defined function: prefix with lcn_
            if is_builtin(fname) {
                sb_append(out, "lcn_")
                sb_append(out, fname)
            } else {
                sb_append(out, "lcn_")
                sb_append(out, fname)
            }
            sb_append(out, "(")
            // Emit args comma-separated
            let ai = 0
            let ap = 0
            let alen = str_len(arg_str)
            for _fa in 0..100 {
                if ap >= alen { break }
                if ai > 0 {
                    sb_append(out, ", ")
                }
                let tab = str_find(str_slice(arg_str, ap, alen), "\t")
                if tab < 0 {
                    sb_append(out, str_slice(arg_str, ap, alen))
                    ap = alen
                } else {
                    sb_append(out, str_slice(arg_str, ap, ap + tab))
                    ap = ap + tab + 1
                }
                ai = ai + 1
            }
            sb_append(out, ")")
        }

    } else if str_eq(tag, "ask") {
        // (ask expr)
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let nlen = str_len(node)
        if p < nlen - 1 {
            let arg_node = child_at(node, p)
            if str_len(arg_node) > 0 {
                sb_append(out, "lcn_ask_typed(NULL, NULL, NULL, ")
                sb_append(out, emit_expr(svars, arg_node))
                sb_append(out, ", NULL, NULL, NULL)")
            } else {
                sb_append(out, "lcn_ask_typed(NULL, NULL, NULL, \"\", NULL, NULL, NULL)")
            }
        } else {
            sb_append(out, "lcn_ask_typed(NULL, NULL, NULL, \"\", NULL, NULL, NULL)")
        }

    } else if str_eq(tag, "field") {
        // (field obj fieldname)
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let obj = child_at(node, p)
        p = skip_child(node, p)
        p = skip_ws(node, p)
        let field_name = read_word(node, p)
        sb_append(out, emit_expr(svars, obj))
        sb_append(out, ".")
        sb_append(out, field_name)

    } else if str_eq(tag, "method") {
        // (method obj methodname args...)
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let obj = child_at(node, p)
        p = skip_child(node, p)
        p = skip_ws(node, p)
        let mname = read_word(node, p)
        p = p + str_len(mname)
        // Collect method args
        let margs = sb_new()
        let mc = 0
        let mnlen = str_len(node)
        for _ma in 0..100 {
            p = skip_ws(node, p)
            if p >= mnlen - 1 { break }
            if char_code(char_at(node, p)) == 41 { break }
            let marg = child_at(node, p)
            if str_len(marg) == 0 { break }
            if mc > 0 {
                sb_append(margs, ", ")
            }
            sb_append(margs, emit_expr(svars, marg))
            mc = mc + 1
            p = skip_child(node, p)
        }
        // Generic: method(&obj, args)
        sb_append(out, mname)
        sb_append(out, "(&")
        sb_append(out, emit_expr(svars, obj))
        if mc > 0 {
            sb_append(out, ", ")
            sb_append(out, sb_to_string(margs))
        }
        sb_append(out, ")")

    } else if str_eq(tag, "map") {
        // (map TypeName (entry field expr) (entry field expr) ...)
        // Emit as: (TypeName){.field = expr, .field = expr, ...}
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let type_name = read_word(node, p)
        p = p + str_len(type_name)
        sb_append(out, "(")
        sb_append(out, type_name)
        sb_append(out, "){")
        let entry_count = 0
        let nlen = str_len(node)
        for _me in 0..100 {
            p = skip_ws(node, p)
            if p >= nlen - 1 { break }
            if char_code(char_at(node, p)) == 41 { break }
            let entry_node = child_at(node, p)
            p = skip_child(node, p)
            // entry_node is "(entry fieldname expr)"
            let ep = after_tag(entry_node, 0)
            ep = skip_ws(entry_node, ep)
            let efield = read_word(entry_node, ep)
            ep = ep + str_len(efield)
            ep = skip_ws(entry_node, ep)
            let eval_node = child_at(entry_node, ep)
            if entry_count > 0 {
                sb_append(out, ", ")
            }
            sb_append(out, ".")
            sb_append(out, efield)
            sb_append(out, " = ")
            sb_append(out, emit_expr(svars, eval_node))
            entry_count = entry_count + 1
        }
        sb_append(out, "}")

    } else if str_eq(tag, "array") {
        // Array literal: emit as a new LcnVec with elements pushed
        // For now, emit lcn_vec_new() — element push requires statement-level code
        sb_append(out, "lcn_vec_new()")

    } else if str_eq(tag, "closure") {
        // (closure (params (pname [:type]) ...) [->rettype] (block ...))
        // The closure function is pre-emitted by the main loop as _lcn_closure_N_fn.
        // We reference it here using the closure ID from svars.
        let cid = get_closure_id(svars)
        let cid_str = to_string(cid)
        sb_append(out, "(LcnClosure){ .fn = (LcnClosureFn)_lcn_closure_")
        sb_append(out, cid_str)
        sb_append(out, "_fn, .env = NULL }")

    } else if str_eq(tag, "try") {
        // (try expr) -> the ? operator, pass through the inner expression
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let inner = child_at(node, p)
        sb_append(out, emit_expr(svars, inner))

    } else if str_eq(tag, "&&") {
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let left = child_at(node, p)
        p = skip_child(node, p)
        p = skip_ws(node, p)
        let right = child_at(node, p)
        sb_append(out, "(")
        sb_append(out, emit_expr(svars, left))
        sb_append(out, " && ")
        sb_append(out, emit_expr(svars, right))
        sb_append(out, ")")

    } else if str_eq(tag, "||") {
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let left = child_at(node, p)
        p = skip_child(node, p)
        p = skip_ws(node, p)
        let right = child_at(node, p)
        sb_append(out, "(")
        sb_append(out, emit_expr(svars, left))
        sb_append(out, " || ")
        sb_append(out, emit_expr(svars, right))
        sb_append(out, ")")

    } else if str_eq(tag, "%") {
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let left = child_at(node, p)
        p = skip_child(node, p)
        p = skip_ws(node, p)
        let right = child_at(node, p)
        sb_append(out, "(")
        sb_append(out, emit_expr(svars, left))
        sb_append(out, " % ")
        sb_append(out, emit_expr(svars, right))
        sb_append(out, ")")

    } else if str_eq(tag, "cast") {
        // (cast expr type) -> (type)expr
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let inner = child_at(node, p)
        p = skip_child(node, p)
        p = skip_ws(node, p)
        let cast_ty = child_at(node, p)
        let cast_tag = node_tag(cast_ty, 0)
        let c_type = "int64_t"
        if str_len(cast_tag) > 0 {
            c_type = resolve_type_expr(cast_ty)
        }
        sb_append(out, "(")
        sb_append(out, c_type)
        sb_append(out, ")(")
        sb_append(out, emit_expr(svars, inner))
        sb_append(out, ")")

    } else if str_eq(tag, "deref") {
        // (deref expr) -> *(expr)
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let inner = child_at(node, p)
        sb_append(out, "*(")
        sb_append(out, emit_expr(svars, inner))
        sb_append(out, ")")

    } else if str_eq(tag, "ref") {
        // (ref expr) -> &(expr)
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let inner = child_at(node, p)
        sb_append(out, "&(")
        sb_append(out, emit_expr(svars, inner))
        sb_append(out, ")")

    } else if str_eq(tag, "index") {
        // (index target idx) -> target[idx]
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let target = child_at(node, p)
        p = skip_child(node, p)
        p = skip_ws(node, p)
        let idx = child_at(node, p)
        sb_append(out, emit_expr(svars, target))
        sb_append(out, "[")
        sb_append(out, emit_expr(svars, idx))
        sb_append(out, "]")

    } else if str_eq(tag, "range") {
        // (range start end) -> no direct C equivalent
        sb_append(out, "/* range */ 0")

    } else if str_eq(tag, "tuple") {
        // (tuple expr1 expr2 ...) -> struct with positional fields
        sb_append(out, "/* tuple */ 0")

    } else if str_eq(tag, "unary") {
        // (unary op expr) -> op(expr)
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let op = read_word(node, p)
        p = p + str_len(op)
        p = skip_ws(node, p)
        let inner = child_at(node, p)
        if str_eq(op, "-") {
            sb_append(out, "-(")
            sb_append(out, emit_expr(svars, inner))
            sb_append(out, ")")
        } else if str_eq(op, "!") {
            sb_append(out, "!(")
            sb_append(out, emit_expr(svars, inner))
            sb_append(out, ")")
        } else {
            sb_append(out, op)
            sb_append(out, "(")
            sb_append(out, emit_expr(svars, inner))
            sb_append(out, ")")
        }

    } else if str_eq(tag, "await") {
        // (await expr) -> lcn_await_task((LcnTaskHandle *)expr)
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let inner = child_at(node, p)
        sb_append(out, "lcn_await_task((LcnTaskHandle *)")
        sb_append(out, emit_expr(svars, inner))
        sb_append(out, ")")

    } else if str_eq(tag, "channel") {
        // (channel capacity) -> lcn_channel_new(capacity, sizeof(LcnString))
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let nlen = str_len(node)
        if p < nlen - 1 {
            let cc = char_code(char_at(node, p))
            if cc != 41 {
                let cap_expr = child_at(node, p)
                sb_append(out, "lcn_channel_new(")
                sb_append(out, emit_expr(svars, cap_expr))
                sb_append(out, ", sizeof(LcnString))")
            } else {
                sb_append(out, "lcn_channel_new(16, sizeof(LcnString))")
            }
        } else {
            sb_append(out, "lcn_channel_new(16, sizeof(LcnString))")
        }

    } else if str_eq(tag, "select") {
        // (select (select_arm varname channel body) ...)
        // Emit: ({ LcnChannel *_sel_chs[] = { ch1, ch2 };
        //          int _sel_idx = lcn_select(_sel_chs, N, 0);
        //          switch (_sel_idx) { case 0: { ... } case 1: { ... } }
        //          _sel_idx; })
        let p = after_tag(node, 0)
        let nlen = str_len(node)
        // Count arms and collect channels
        let arm_count = 0
        let chan_buf = sb_new()
        let arms_buf = sb_new()
        let tp = p
        for _sc in 0..100 {
            tp = skip_ws(node, tp)
            if tp >= nlen - 1 { break }
            if char_code(char_at(node, tp)) == 41 { break }
            let arm = child_at(node, tp)
            if str_len(arm) == 0 { break }
            let atag = node_tag(arm, 0)
            if str_eq(atag, "select_arm") {
                let ap = after_tag(arm, 0)
                ap = skip_ws(arm, ap)
                let vname = read_word(arm, ap)
                ap = ap + str_len(vname)
                ap = skip_ws(arm, ap)
                let chan_expr = child_at(arm, ap)
                ap = skip_child(arm, ap)
                ap = skip_ws(arm, ap)
                let arm_body = child_at(arm, ap)
                if arm_count > 0 {
                    sb_append(chan_buf, ", ")
                }
                sb_append(chan_buf, emit_expr(svars, chan_expr))
                sb_append(arms_buf, "case ")
                sb_append(arms_buf, to_string(arm_count))
                sb_append(arms_buf, ": { LcnString ")
                sb_append(arms_buf, vname)
                sb_append(arms_buf, "; lcn_channel_recv(")
                sb_append(arms_buf, emit_expr(svars, chan_expr))
                sb_append(arms_buf, ", &")
                sb_append(arms_buf, vname)
                sb_append(arms_buf, "); ")
                let arm_code = emit_block_inner(svars, arm_body, 2)
                sb_append(arms_buf, unpack_code(arm_code))
                sb_append(arms_buf, " break; } ")
                arm_count = arm_count + 1
            }
            tp = skip_child(node, tp)
        }
        if arm_count == 0 {
            sb_append(out, "/* select: no arms */ (-1)")
        } else {
            sb_append(out, "({ LcnChannel *_sel_chs[] = { ")
            sb_append(out, sb_to_string(chan_buf))
            sb_append(out, " }; int _sel_idx = lcn_select(_sel_chs, ")
            sb_append(out, to_string(arm_count))
            sb_append(out, ", 0); switch (_sel_idx) { ")
            sb_append(out, sb_to_string(arms_buf))
            sb_append(out, "} _sel_idx; })")
        }

    } else if str_eq(tag, "spawn") {
        // (spawn body) -> lcn_spawn_task or lcn_green_spawn wrapper
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let use_green_raw = env("LCN_GREEN_THREADS")
        let use_green = "0"
        if str_len(use_green_raw) > 0 {
            use_green = use_green_raw
        }
        if str_eq(use_green, "1") {
            sb_append(out, "/* spawn (green) */ lcn_green_spawn((void *(*)(void *))NULL, NULL)")
        } else {
            sb_append(out, "/* spawn */ lcn_spawn_task((LcnTaskFn)NULL, NULL)")
        }

    } else if str_eq(tag, "tell") {
        // (tell target message) -> printf("AGENT -> target: %s\n", message)
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let target = child_at(node, p)
        p = skip_child(node, p)
        p = skip_ws(node, p)
        let message = child_at(node, p)
        let target_tag = node_tag(target, 0)
        let target_name = "?"
        if str_eq(target_tag, "ident") {
            let tp2 = after_tag(target, 0)
            tp2 = skip_ws(target, tp2)
            target_name = read_word(target, tp2)
        }
        sb_append(out, "printf(\"AGENT -> ")
        sb_append(out, target_name)
        sb_append(out, ": %s\\n\", ")
        sb_append(out, emit_expr(svars, message))
        sb_append(out, ")")

    } else if str_eq(tag, "try_otherwise") {
        // (try_otherwise expr fallback)
        // -> ({ LcnLlmOutput _to = expr; if (_to.kind == LCN_LLM_ERROR) { _to = fallback; } _to; })
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let try_expr = child_at(node, p)
        p = skip_child(node, p)
        p = skip_ws(node, p)
        let fallback = child_at(node, p)
        sb_append(out, "({ LcnLlmOutput _to_0 = ")
        sb_append(out, emit_expr(svars, try_expr))
        sb_append(out, "; if (_to_0.kind == LCN_LLM_ERROR) { _to_0 = ")
        sb_append(out, emit_expr(svars, fallback))
        sb_append(out, "; } _to_0; })")

    } else if str_eq(tag, "keep_where") {
        // (keep_where condition) -> standalone: unsupported, handled in pipe context
        sb_append(out, "/* keep where: standalone usage unsupported */ 0")

    } else if str_eq(tag, "each") {
        // (each field) -> standalone: unsupported, handled in pipe context
        sb_append(out, "/* each: standalone usage unsupported */ 0")

    } else if str_eq(tag, "pipe") {
        // (pipe left right) -> right(left), alias of |>
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let left = child_at(node, p)
        p = skip_child(node, p)
        p = skip_ws(node, p)
        let right = child_at(node, p)
        sb_append(out, emit_expr(svars, right))
        sb_append(out, "(")
        sb_append(out, emit_expr(svars, left))
        sb_append(out, ")")

    } else if str_eq(tag, "comptime") {
        // (comptime (block ...)) -> evaluate at compile time
        // Stage 1 simplified: emit the inner block as a GCC statement-expression
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let ct_body = child_at(node, p)
        let ct_tag = node_tag(ct_body, 0)
        if str_eq(ct_tag, "block") {
            sb_append(out, "/* comptime */ ({\n")
            let bip = after_tag(ct_body, 0)
            let bilen = str_len(ct_body)
            for _ct in 0..5000 {
                bip = skip_ws(ct_body, bip)
                if bip >= bilen - 1 { break }
                if char_code(char_at(ct_body, bip)) == 41 { break }
                let ct_stmt = child_at(ct_body, bip)
                if str_len(ct_stmt) == 0 { break }
                bip = skip_child(ct_body, bip)
                let ct_next = skip_ws(ct_body, bip)
                let ct_is_last = false
                if ct_next >= bilen - 1 {
                    ct_is_last = true
                } else if char_code(char_at(ct_body, ct_next)) == 41 {
                    ct_is_last = true
                }
                if ct_is_last {
                    // Last expression: emit as the result
                    let cts_tag = node_tag(ct_stmt, 0)
                    let ct_is_expr = false
                    if str_eq(cts_tag, "int") { ct_is_expr = true
                    } else if str_eq(cts_tag, "float") { ct_is_expr = true
                    } else if str_eq(cts_tag, "string") { ct_is_expr = true
                    } else if str_eq(cts_tag, "bool") { ct_is_expr = true
                    } else if str_eq(cts_tag, "call") { ct_is_expr = true
                    } else if str_eq(cts_tag, "ident") { ct_is_expr = true
                    } else if str_eq(cts_tag, "+") { ct_is_expr = true
                    } else if str_eq(cts_tag, "-") { ct_is_expr = true
                    } else if str_eq(cts_tag, "*") { ct_is_expr = true
                    } else if str_eq(cts_tag, "/") { ct_is_expr = true
                    }
                    if ct_is_expr {
                        sb_append(out, "    ")
                        sb_append(out, emit_expr(svars, ct_stmt))
                        sb_append(out, ";\n")
                    } else {
                        let ct_res = emit_stmt(svars, ct_stmt, 1)
                        sb_append(out, unpack_code(ct_res))
                    }
                } else {
                    let ct_res = emit_stmt(svars, ct_stmt, 1)
                    sb_append(out, unpack_code(ct_res))
                }
            }
            sb_append(out, "})")
        } else {
            // Single expression comptime
            sb_append(out, "/* comptime */ ")
            sb_append(out, emit_expr(svars, ct_body))
        }

    } else if str_eq(tag, "task_group") {
        // (task_group (block (spawn expr) (spawn expr) ...))
        // Emit statement-expression: ({ LcnTaskGroup *tg = ...; spawn; await_all; results; })
        sb_append(out, "({ /* task_group */\n")
        sb_append(out, "    LcnTaskGroup *__lcn_tg = lcn_task_group_new();\n")
        let tgp = after_tag(node, 0)
        tgp = skip_ws(node, tgp)
        let tg_body = child_at(node, tgp)
        let tg_btag = node_tag(tg_body, 0)
        if str_eq(tg_btag, "block") {
            let tgbp = after_tag(tg_body, 0)
            let tgblen = str_len(tg_body)
            for _tg in 0..200 {
                tgbp = skip_ws(tg_body, tgbp)
                if tgbp >= tgblen - 1 { break }
                if char_code(char_at(tg_body, tgbp)) == 41 { break }
                let tg_stmt = child_at(tg_body, tgbp)
                tgbp = skip_child(tg_body, tgbp)
                let tgs_tag = node_tag(tg_stmt, 0)
                if str_eq(tgs_tag, "spawn") {
                    sb_append(out, "    lcn_task_group_spawn(__lcn_tg, (LcnTaskFn)NULL, NULL);\n")
                } else {
                    let tg_res = emit_stmt(svars, tg_stmt, 1)
                    sb_append(out, unpack_code(tg_res))
                }
            }
        }
        sb_append(out, "    void **__lcn_tg_results = lcn_task_group_await_all(__lcn_tg);\n")
        sb_append(out, "    lcn_task_group_free(__lcn_tg);\n")
        sb_append(out, "    __lcn_tg_results;\n")
        sb_append(out, "})")

    } else {
        sb_append(out, "/* TODO: expr ")
        sb_append(out, tag)
        sb_append(out, " */0")
    }

    sb_to_string(out)
}

// Extract the nth tab-separated argument from a string
fn emit_arg(arg_str: string, n: int) -> string {
    let r = ""
    let pos = 0
    let alen = str_len(arg_str)
    let idx = 0
    for _ea in 0..100 {
        if pos >= alen { break }
        if idx == n {
            let tab = str_find(str_slice(arg_str, pos, alen), "\t")
            if tab < 0 {
                r = str_slice(arg_str, pos, alen)
            } else {
                r = str_slice(arg_str, pos, pos + tab)
            }
            break
        }
        // Skip to next tab
        let rest = str_slice(arg_str, pos, alen)
        let tab = str_find(rest, "\t")
        if tab < 0 { break }
        pos = pos + tab + 1
        idx = idx + 1
    }
    if str_len(r) == 0 {
        r = "0"
    }
    r
}

// ── Statement Code Generation ───────────────────────────────
// emit_stmt returns (new_svars, code_string) packed as "svars<<SC>>code"
// We use <<SC>> as separator since it won't appear in generated C code.

fn pack_sc(svars: string, code: string) -> string {
    svars + "<<SC>>" + code
}

fn unpack_svars(packed: string) -> string {
    let sep = str_find(packed, "<<SC>>")
    let r = ""
    if sep < 0 {
        r = ""
    } else {
        r = str_slice(packed, 0, sep)
    }
    r
}

fn unpack_code(packed: string) -> string {
    let sep = str_find(packed, "<<SC>>")
    let r = packed
    if sep >= 0 {
        r = str_slice(packed, sep + 6, str_len(packed))
    }
    r
}

fn emit_stmt(svars: string, node: string, indent: int) -> string {
    let tag = node_tag(node, 0)
    let out = sb_new()
    let new_svars = svars

    if str_eq(tag, "let") {
        // (let name [:type] expr)  or  (let name [:type])
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let name = read_word(node, p)
        p = p + str_len(name)
        p = skip_ws(node, p)

        // Check for type annotation: starts with ':'
        let ty = ""
        let nlen = str_len(node)
        if p < nlen {
            let next_c = char_at(node, p)
            if char_code(next_c) == 58 {
                // colon — type annotation
                p = p + 1
                ty = read_word(node, p)
                p = p + str_len(ty)
                p = skip_ws(node, p)
            }
        }

        // Check if there's an initializer
        let has_init = false
        if p < nlen - 1 {
            let cc = char_code(char_at(node, p))
            if cc != 41 {
                has_init = true
            }
        }

        if has_init {
            let init_node = child_at(node, p)
            let init_code = emit_expr(svars, init_node)

            // Determine C type
            let c_type = ""
            if str_len(ty) > 0 {
                c_type = map_type(ty)
            } else {
                c_type = infer_type(svars, init_node)
            }

            out = sb_new()
            sb_append(out, emit_indent("", indent))
            sb_append(out, c_type)
            sb_append(out, " ")
            sb_append(out, name)
            sb_append(out, " = ")
            sb_append(out, init_code)
            sb_append(out, ";\n")

            // Track string vars
            let is_str = false
            if str_eq(c_type, "LcnString") {
                is_str = true
            } else if might_be_string(svars, init_node) {
                is_str = true
            }
            if is_str {
                new_svars = add_string_var(svars, name)
            }
        } else {
            // No initializer
            let c_type = "int64_t"
            if str_len(ty) > 0 {
                c_type = map_type(ty)
            }
            out = sb_new()
            sb_append(out, emit_indent("", indent))
            sb_append(out, c_type)
            sb_append(out, " ")
            sb_append(out, name)
            sb_append(out, ";\n")
        }

    } else if str_eq(tag, "assign") {
        // (assign lhs rhs)
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let lhs = child_at(node, p)
        p = skip_child(node, p)
        p = skip_ws(node, p)
        let rhs = child_at(node, p)
        out = sb_new()
        sb_append(out, emit_indent("", indent))
        sb_append(out, emit_expr(svars, lhs))
        sb_append(out, " = ")
        sb_append(out, emit_expr(svars, rhs))
        sb_append(out, ";\n")

    } else if str_eq(tag, "return") {
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let nlen = str_len(node)
        out = sb_new()
        sb_append(out, emit_indent("", indent))
        if p < nlen - 1 {
            let cc = char_code(char_at(node, p))
            if cc != 41 {
                let val = child_at(node, p)
                sb_append(out, "return ")
                sb_append(out, emit_expr(svars, val))
                sb_append(out, ";\n")
            } else {
                sb_append(out, "return;\n")
            }
        } else {
            sb_append(out, "return;\n")
        }

    } else if str_eq(tag, "break") {
        out = sb_new()
        sb_append(out, emit_indent("", indent))
        sb_append(out, "break;\n")

    } else if str_eq(tag, "continue") {
        out = sb_new()
        sb_append(out, emit_indent("", indent))
        sb_append(out, "continue;\n")

    } else if str_eq(tag, "if") {
        // (if cond then_block [else_branch])
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let cond = child_at(node, p)
        p = skip_child(node, p)
        p = skip_ws(node, p)
        let then_b = child_at(node, p)
        p = skip_child(node, p)
        p = skip_ws(node, p)

        out = sb_new()
        sb_append(out, emit_indent("", indent))
        sb_append(out, "if (")
        sb_append(out, emit_expr(svars, cond))
        sb_append(out, ") ")
        let then_code = emit_block(svars, then_b, indent)
        new_svars = unpack_svars(then_code)
        sb_append(out, unpack_code(then_code))

        // Check for else branch
        let nlen = str_len(node)
        if p < nlen - 1 {
            let cc = char_code(char_at(node, p))
            if cc != 41 {
                let else_branch = child_at(node, p)
                let else_tag = node_tag(else_branch, 0)
                if str_eq(else_tag, "if") {
                    sb_append(out, " else ")
                    let else_result = emit_stmt(new_svars, else_branch, indent)
                    new_svars = unpack_svars(else_result)
                    sb_append(out, str_trim_left(unpack_code(else_result)))
                } else {
                    sb_append(out, " else ")
                    let else_code = emit_block(new_svars, else_branch, indent)
                    new_svars = unpack_svars(else_code)
                    sb_append(out, unpack_code(else_code))
                    sb_append(out, "\n")
                }
            } else {
                sb_append(out, "\n")
            }
        } else {
            sb_append(out, "\n")
        }

    } else if str_eq(tag, "for") {
        // (for varname (range start end) body) or (for varname collection body)
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let var_name = read_word(node, p)
        p = p + str_len(var_name)
        p = skip_ws(node, p)

        let range_or_coll = child_at(node, p)
        p = skip_child(node, p)
        p = skip_ws(node, p)
        let body = child_at(node, p)

        let rtag = node_tag(range_or_coll, 0)
        out = sb_new()
        if str_eq(rtag, "range") {
            // Range for loop
            let rp = after_tag(range_or_coll, 0)
            rp = skip_ws(range_or_coll, rp)
            let start_expr = child_at(range_or_coll, rp)
            rp = skip_child(range_or_coll, rp)
            rp = skip_ws(range_or_coll, rp)
            let end_expr = child_at(range_or_coll, rp)

            sb_append(out, emit_indent("", indent))
            sb_append(out, "{ int64_t ")
            sb_append(out, var_name)
            sb_append(out, "; for (")
            sb_append(out, var_name)
            sb_append(out, " = ")
            sb_append(out, emit_expr(svars, start_expr))
            sb_append(out, "; ")
            sb_append(out, var_name)
            sb_append(out, " < ")
            sb_append(out, emit_expr(svars, end_expr))
            sb_append(out, "; ")
            sb_append(out, var_name)
            sb_append(out, "++) ")
            let body_code = emit_block(svars, body, indent)
            new_svars = unpack_svars(body_code)
            sb_append(out, unpack_code(body_code))
            sb_append(out, " }\n")
        } else {
            // For-in collection (simplified: one iteration)
            sb_append(out, emit_indent("", indent))
            sb_append(out, "{ /* for ")
            sb_append(out, var_name)
            sb_append(out, " in ... */\n")
            sb_append(out, emit_indent("", indent + 1))
            sb_append(out, "LcnString ")
            sb_append(out, var_name)
            sb_append(out, " = (LcnString)")
            sb_append(out, emit_expr(svars, range_or_coll))
            sb_append(out, ";\n")
            sb_append(out, emit_indent("", indent + 1))
            sb_append(out, "(void)")
            sb_append(out, var_name)
            sb_append(out, ";\n")
            // Emit body statements
            let bi = emit_block_inner(svars, body, indent + 1)
            new_svars = unpack_svars(bi)
            sb_append(out, unpack_code(bi))
            sb_append(out, emit_indent("", indent))
            sb_append(out, "}\n")
        }

    } else if str_eq(tag, "while") {
        // (while cond body)
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let cond = child_at(node, p)
        p = skip_child(node, p)
        p = skip_ws(node, p)
        let body = child_at(node, p)

        out = sb_new()
        sb_append(out, emit_indent("", indent))
        sb_append(out, "while (")
        sb_append(out, emit_expr(svars, cond))
        sb_append(out, ") ")
        let body_code = emit_block(svars, body, indent)
        new_svars = unpack_svars(body_code)
        sb_append(out, unpack_code(body_code))
        sb_append(out, "\n")

    } else if str_eq(tag, "loop") {
        // (loop body)
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let body = child_at(node, p)

        out = sb_new()
        sb_append(out, emit_indent("", indent))
        sb_append(out, "while (1) ")
        let body_code = emit_block(svars, body, indent)
        new_svars = unpack_svars(body_code)
        sb_append(out, unpack_code(body_code))
        sb_append(out, "\n")

    } else if str_eq(tag, "match") {
        // (match subject (arm pattern body) ...)
        // Detects match strategy from pattern types:
        //   - string patterns → if/else chain with strcmp()
        //   - int patterns → switch/case
        //   - call patterns (LLM output) → switch on .kind
        //   - ident patterns → if/else chain with strcmp()
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let subject = child_at(node, p)
        p = skip_child(node, p)

        out = sb_new()
        sb_append(out, emit_indent("", indent))
        sb_append(out, "{\n")

        // Determine type of subject
        let subj_type = infer_type(svars, subject)

        // First pass: scan arms to detect match strategy
        // "str" = string patterns, "int" = int patterns,
        // "llm" = LLM output (call Ok/Error/Text/ToolCall), "generic" = fallback
        let match_strategy = "generic"
        let scan_p = p
        let scan_nlen = str_len(node)
        for _scan in 0..100 {
            scan_p = skip_ws(node, scan_p)
            if scan_p >= scan_nlen - 1 { break }
            if char_code(char_at(node, scan_p)) == 41 { break }
            let scan_arm = child_at(node, scan_p)
            scan_p = skip_child(node, scan_p)
            let scan_tag = node_tag(scan_arm, 0)
            if str_eq(scan_tag, "arm") {
                let sap = after_tag(scan_arm, 0)
                sap = skip_ws(scan_arm, sap)
                let scan_pat = child_at(scan_arm, sap)
                let spt = node_tag(scan_pat, 0)
                if str_eq(spt, "string") {
                    match_strategy = "str"
                    break
                } else if str_eq(spt, "int") {
                    match_strategy = "int"
                    break
                } else if str_eq(spt, "call") {
                    match_strategy = "llm"
                    break
                } else if str_eq(spt, "ident") {
                    // Could be wildcard _ or a named ident — keep scanning
                    let spp = after_tag(scan_pat, 0)
                    spp = skip_ws(scan_pat, spp)
                    let spname = read_word(scan_pat, spp)
                    if str_eq(spname, "_") {
                        // Wildcard only — keep scanning for a real pattern
                        match_strategy = "generic"
                    } else {
                        // Named ident pattern — treat as string comparison
                        match_strategy = "str"
                        break
                    }
                }
            }
        }

        // Override subject type when match strategy implies it
        if str_eq(match_strategy, "llm") {
            subj_type = "LcnLlmOutput"
        }

        // Emit subject into temp variable
        sb_append(out, emit_indent("", indent + 1))
        sb_append(out, subj_type)
        sb_append(out, " _match_subj = ")
        sb_append(out, emit_expr(svars, subject))
        sb_append(out, ";\n")

        // ── Integer match: switch/case ──
        if str_eq(match_strategy, "int") {
            sb_append(out, emit_indent("", indent + 1))
            sb_append(out, "switch (_match_subj) {\n")
            let nlen = str_len(node)
            for _arm in 0..100 {
                p = skip_ws(node, p)
                if p >= nlen - 1 { break }
                if char_code(char_at(node, p)) == 41 { break }
                let arm = child_at(node, p)
                p = skip_child(node, p)
                let arm_tag = node_tag(arm, 0)
                if str_eq(arm_tag, "arm") {
                    let ap = after_tag(arm, 0)
                    ap = skip_ws(arm, ap)
                    let pattern = child_at(arm, ap)
                    ap = skip_child(arm, ap)
                    ap = skip_ws(arm, ap)
                    let arm_body = child_at(arm, ap)

                    let pat_tag = node_tag(pattern, 0)

                    if str_eq(pat_tag, "int") {
                        // (int N) → case N:
                        let ip = after_tag(pattern, 0)
                        ip = skip_ws(pattern, ip)
                        let ival = read_word(pattern, ip)
                        sb_append(out, emit_indent("", indent + 2))
                        sb_append(out, "case ")
                        sb_append(out, ival)
                        sb_append(out, ": {\n")
                        let arm_inner = emit_block_inner(new_svars, arm_body, indent + 3)
                        new_svars = unpack_svars(arm_inner)
                        sb_append(out, unpack_code(arm_inner))
                        sb_append(out, emit_indent("", indent + 3))
                        sb_append(out, "break;\n")
                        sb_append(out, emit_indent("", indent + 2))
                        sb_append(out, "}\n")
                    } else if str_eq(pat_tag, "ident") {
                        // Wildcard _ or named catch-all → default:
                        let pp = after_tag(pattern, 0)
                        pp = skip_ws(pattern, pp)
                        let pname = read_word(pattern, pp)
                        sb_append(out, emit_indent("", indent + 2))
                        sb_append(out, "default: {\n")
                        if str_eq(pname, "_") {
                            // Pure wildcard — no binding needed
                        } else {
                            // Named catch-all: bind _match_subj to the name
                            sb_append(out, emit_indent("", indent + 3))
                            sb_append(out, subj_type)
                            sb_append(out, " ")
                            sb_append(out, pname)
                            sb_append(out, " = _match_subj;\n")
                        }
                        let arm_inner = emit_block_inner(new_svars, arm_body, indent + 3)
                        new_svars = unpack_svars(arm_inner)
                        sb_append(out, unpack_code(arm_inner))
                        sb_append(out, emit_indent("", indent + 3))
                        sb_append(out, "break;\n")
                        sb_append(out, emit_indent("", indent + 2))
                        sb_append(out, "}\n")
                    }
                }
            }
            sb_append(out, emit_indent("", indent + 1))
            sb_append(out, "}\n")

        // ── LLM output match: switch on .kind ──
        } else if str_eq(match_strategy, "llm") {
            sb_append(out, emit_indent("", indent + 1))
            sb_append(out, "switch (_match_subj.kind) {\n")
            let nlen = str_len(node)
            for _arm in 0..100 {
                p = skip_ws(node, p)
                if p >= nlen - 1 { break }
                if char_code(char_at(node, p)) == 41 { break }
                let arm = child_at(node, p)
                p = skip_child(node, p)
                let arm_tag = node_tag(arm, 0)
                if str_eq(arm_tag, "arm") {
                    let ap = after_tag(arm, 0)
                    ap = skip_ws(arm, ap)
                    let pattern = child_at(arm, ap)
                    ap = skip_child(arm, ap)
                    ap = skip_ws(arm, ap)
                    let arm_body = child_at(arm, ap)

                    let pat_tag = node_tag(pattern, 0)

                    if str_eq(pat_tag, "call") {
                        // (call Variant (ident binding) ...)
                        let cp = after_tag(pattern, 0)
                        cp = skip_ws(pattern, cp)
                        let variant = read_word(pattern, cp)
                        cp = cp + str_len(variant)

                        // Map variant name to C enum constant
                        let case_label = "/* unknown */"
                        if str_eq(variant, "Ok") {
                            case_label = "LCN_LLM_OUTPUT_OK"
                        } else if str_eq(variant, "Text") {
                            case_label = "LCN_LLM_OUTPUT_TEXT"
                        } else if str_eq(variant, "ToolCall") {
                            case_label = "LCN_LLM_OUTPUT_TOOL_CALL"
                        } else if str_eq(variant, "Error") {
                            case_label = "LCN_LLM_OUTPUT_ERROR"
                        }

                        sb_append(out, emit_indent("", indent + 2))
                        sb_append(out, "case ")
                        sb_append(out, case_label)
                        sb_append(out, ": {\n")

                        // Bind destructured fields
                        cp = skip_ws(pattern, cp)
                        let cplen = str_len(pattern)
                        if cp < cplen - 1 {
                            if char_code(char_at(pattern, cp)) != 41 {
                                let field1 = child_at(pattern, cp)
                                let f1tag = node_tag(field1, 0)
                                if str_eq(f1tag, "ident") {
                                    let fp = after_tag(field1, 0)
                                    fp = skip_ws(field1, fp)
                                    let fname = read_word(field1, fp)
                                    if str_eq(variant, "Ok") {
                                        sb_append(out, emit_indent("", indent + 3))
                                        sb_append(out, "LcnString ")
                                        sb_append(out, fname)
                                        sb_append(out, " = _match_subj.content;\n")
                                    } else if str_eq(variant, "Text") {
                                        sb_append(out, emit_indent("", indent + 3))
                                        sb_append(out, "LcnString ")
                                        sb_append(out, fname)
                                        sb_append(out, " = _match_subj.content;\n")
                                    } else if str_eq(variant, "ToolCall") {
                                        sb_append(out, emit_indent("", indent + 3))
                                        sb_append(out, "LcnString ")
                                        sb_append(out, fname)
                                        sb_append(out, " = _match_subj.tool_name;\n")
                                        // Check for second field (args)
                                        cp = skip_child(pattern, cp)
                                        cp = skip_ws(pattern, cp)
                                        if cp < cplen - 1 {
                                            if char_code(char_at(pattern, cp)) != 41 {
                                                let field2 = child_at(pattern, cp)
                                                let f2tag = node_tag(field2, 0)
                                                if str_eq(f2tag, "ident") {
                                                    let fp2 = after_tag(field2, 0)
                                                    fp2 = skip_ws(field2, fp2)
                                                    let fname2 = read_word(field2, fp2)
                                                    sb_append(out, emit_indent("", indent + 3))
                                                    sb_append(out, "LcnString ")
                                                    sb_append(out, fname2)
                                                    sb_append(out, " = _match_subj.tool_args;\n")
                                                }
                                            }
                                        }
                                    } else if str_eq(variant, "Error") {
                                        sb_append(out, emit_indent("", indent + 3))
                                        sb_append(out, "LcnString ")
                                        sb_append(out, fname)
                                        sb_append(out, " = _match_subj.error;\n")
                                    }
                                }
                            }
                        }

                        let arm_inner = emit_block_inner(new_svars, arm_body, indent + 3)
                        new_svars = unpack_svars(arm_inner)
                        sb_append(out, unpack_code(arm_inner))
                        sb_append(out, emit_indent("", indent + 3))
                        sb_append(out, "break;\n")
                        sb_append(out, emit_indent("", indent + 2))
                        sb_append(out, "}\n")
                    } else if str_eq(pat_tag, "ident") {
                        // Wildcard _ → default:
                        let pp = after_tag(pattern, 0)
                        pp = skip_ws(pattern, pp)
                        let pname = read_word(pattern, pp)
                        sb_append(out, emit_indent("", indent + 2))
                        sb_append(out, "default: {\n")
                        if str_eq(pname, "_") {
                            // Pure wildcard
                        } else {
                            // Named catch-all
                            sb_append(out, emit_indent("", indent + 3))
                            sb_append(out, "LcnLlmOutput ")
                            sb_append(out, pname)
                            sb_append(out, " = _match_subj;\n")
                        }
                        let arm_inner = emit_block_inner(new_svars, arm_body, indent + 3)
                        new_svars = unpack_svars(arm_inner)
                        sb_append(out, unpack_code(arm_inner))
                        sb_append(out, emit_indent("", indent + 3))
                        sb_append(out, "break;\n")
                        sb_append(out, emit_indent("", indent + 2))
                        sb_append(out, "}\n")
                    }
                }
            }
            sb_append(out, emit_indent("", indent + 1))
            sb_append(out, "}\n")

        // ── String match (and generic): if/else chain with strcmp ──
        } else {
            let nlen = str_len(node)
            let first_arm = true
            for _arm in 0..100 {
                p = skip_ws(node, p)
                if p >= nlen - 1 { break }
                if char_code(char_at(node, p)) == 41 { break }
                let arm = child_at(node, p)
                p = skip_child(node, p)
                let arm_tag = node_tag(arm, 0)
                if str_eq(arm_tag, "arm") {
                    let ap = after_tag(arm, 0)
                    ap = skip_ws(arm, ap)
                    let pattern = child_at(arm, ap)
                    ap = skip_child(arm, ap)
                    ap = skip_ws(arm, ap)
                    let arm_body = child_at(arm, ap)

                    let pat_tag = node_tag(pattern, 0)
                    sb_append(out, emit_indent("", indent + 1))

                    if str_eq(pat_tag, "string") {
                        // (string "value") → strcmp
                        let str_val = emit_expr(new_svars, pattern)
                        if first_arm {
                            sb_append(out, "if (strcmp(_match_subj, ")
                        } else {
                            sb_append(out, "else if (strcmp(_match_subj, ")
                        }
                        sb_append(out, str_val)
                        sb_append(out, ") == 0) {\n")
                        let arm_inner = emit_block_inner(new_svars, arm_body, indent + 2)
                        new_svars = unpack_svars(arm_inner)
                        sb_append(out, unpack_code(arm_inner))
                        sb_append(out, emit_indent("", indent + 1))
                        sb_append(out, "}\n")
                    } else if str_eq(pat_tag, "ident") {
                        let pp = after_tag(pattern, 0)
                        pp = skip_ws(pattern, pp)
                        let pname = read_word(pattern, pp)
                        if str_eq(pname, "_") {
                            // Wildcard — else
                            if first_arm {
                                sb_append(out, "{\n")
                            } else {
                                sb_append(out, "else {\n")
                            }
                            let arm_inner = emit_block_inner(new_svars, arm_body, indent + 2)
                            new_svars = unpack_svars(arm_inner)
                            sb_append(out, unpack_code(arm_inner))
                            sb_append(out, emit_indent("", indent + 1))
                            sb_append(out, "}\n")
                        } else {
                            // Match on pattern name — strcmp comparison
                            if first_arm {
                                sb_append(out, "if (strcmp(_match_subj, \"")
                                sb_append(out, pname)
                                sb_append(out, "\") == 0) {\n")
                            } else {
                                sb_append(out, "else if (strcmp(_match_subj, \"")
                                sb_append(out, pname)
                                sb_append(out, "\") == 0) {\n")
                            }
                            let arm_inner = emit_block_inner(new_svars, arm_body, indent + 2)
                            new_svars = unpack_svars(arm_inner)
                            sb_append(out, unpack_code(arm_inner))
                            sb_append(out, emit_indent("", indent + 1))
                            sb_append(out, "}\n")
                        }
                    } else if str_eq(pat_tag, "int") {
                        // Fallback: int pattern in if/else chain (shouldn't normally happen)
                        let ip = after_tag(pattern, 0)
                        ip = skip_ws(pattern, ip)
                        let ival = read_word(pattern, ip)
                        if first_arm {
                            sb_append(out, "if (_match_subj == ")
                        } else {
                            sb_append(out, "else if (_match_subj == ")
                        }
                        sb_append(out, ival)
                        sb_append(out, ") {\n")
                        let arm_inner = emit_block_inner(new_svars, arm_body, indent + 2)
                        new_svars = unpack_svars(arm_inner)
                        sb_append(out, unpack_code(arm_inner))
                        sb_append(out, emit_indent("", indent + 1))
                        sb_append(out, "}\n")
                    } else {
                        // Other pattern types — compare as expression
                        if first_arm {
                            sb_append(out, "if (_match_subj == ")
                        } else {
                            sb_append(out, "else if (_match_subj == ")
                        }
                        sb_append(out, emit_expr(new_svars, pattern))
                        sb_append(out, ") {\n")
                        let arm_inner = emit_block_inner(new_svars, arm_body, indent + 2)
                        new_svars = unpack_svars(arm_inner)
                        sb_append(out, unpack_code(arm_inner))
                        sb_append(out, emit_indent("", indent + 1))
                        sb_append(out, "}\n")
                    }
                    first_arm = false
                }
            }
        }
        sb_append(out, emit_indent("", indent))
        sb_append(out, "}\n")

    } else if str_eq(tag, "ensure") {
        // (ensure condition [message])
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let cond = child_at(node, p)
        p = skip_child(node, p)
        p = skip_ws(node, p)

        let nlen = str_len(node)
        let has_msg = false
        let msg_node = ""
        if p < nlen - 1 {
            let cc = char_code(char_at(node, p))
            if cc != 41 {
                has_msg = true
                msg_node = child_at(node, p)
            }
        }

        out = sb_new()
        sb_append(out, emit_indent("", indent))
        sb_append(out, "if (!(")
        sb_append(out, emit_expr(svars, cond))
        sb_append(out, ")) {\n")
        sb_append(out, emit_indent("", indent + 1))
        if has_msg {
            sb_append(out, "fprintf(stderr, \"ensure failed: %s\\n\", ")
            sb_append(out, emit_expr(svars, msg_node))
            sb_append(out, ");\n")
            sb_append(out, emit_indent("", indent + 1))
            sb_append(out, "return LCN_ERR(")
            sb_append(out, emit_expr(svars, msg_node))
            sb_append(out, ");\n")
        } else {
            sb_append(out, "fprintf(stderr, \"ensure failed\\n\");\n")
            sb_append(out, emit_indent("", indent + 1))
            sb_append(out, "return LCN_ERR(\"ensure failed\");\n")
        }
        sb_append(out, emit_indent("", indent))
        sb_append(out, "}\n")

    } else if str_eq(tag, "expr_stmt") {
        // (expr_stmt inner) -> emit inner as expression statement
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let inner = child_at(node, p)
        let inner_tag = node_tag(inner, 0)
        // If wrapping an if or match, delegate to statement handler
        if str_eq(inner_tag, "if") {
            let result = emit_stmt(svars, inner, indent)
            new_svars = unpack_svars(result)
            out = sb_new()
            sb_append(out, unpack_code(result))
        } else if str_eq(inner_tag, "match") {
            let result = emit_stmt(svars, inner, indent)
            new_svars = unpack_svars(result)
            out = sb_new()
            sb_append(out, unpack_code(result))
        } else {
            out = sb_new()
            sb_append(out, emit_indent("", indent))
            sb_append(out, emit_expr(svars, inner))
            sb_append(out, ";\n")
        }

    } else if str_eq(tag, "defer") {
        // (defer body) -> emit body as comment placeholder for defer stack
        // Stage 1 simplified: emit the deferred code inline at point of declaration
        // with a comment noting it should run at scope exit
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let body = child_at(node, p)
        out = sb_new()
        sb_append(out, emit_indent("", indent))
        sb_append(out, "/* defer: pushed to scope exit */ ")
        sb_append(out, "/* TODO: defer stack LIFO emission */\n")

    } else if str_eq(tag, "repeat") {
        // (repeat count body) -> for (_repeat_i = 0; _repeat_i < count; _repeat_i++) { body }
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let count_expr = child_at(node, p)
        p = skip_child(node, p)
        p = skip_ws(node, p)
        let body = child_at(node, p)
        out = sb_new()
        sb_append(out, emit_indent("", indent))
        sb_append(out, "{ int64_t _repeat_n = ")
        sb_append(out, emit_expr(svars, count_expr))
        sb_append(out, "; int64_t _repeat_i;\n")
        sb_append(out, emit_indent("", indent))
        sb_append(out, "for (_repeat_i = 0; _repeat_i < _repeat_n; _repeat_i++) ")
        let body_code = emit_block(svars, body, indent)
        new_svars = unpack_svars(body_code)
        sb_append(out, unpack_code(body_code))
        sb_append(out, "\n")
        sb_append(out, emit_indent("", indent))
        sb_append(out, "}\n")

    } else if str_eq(tag, "wait_until") {
        // (wait_until cond) -> while (!(cond)) { usleep(100000); }
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let cond = child_at(node, p)
        out = sb_new()
        sb_append(out, emit_indent("", indent))
        sb_append(out, "while (!(")
        sb_append(out, emit_expr(svars, cond))
        sb_append(out, ")) { usleep(100000); /* 100ms poll */ }\n")

    } else if str_eq(tag, "task_group") {
        // (task_group (block (spawn expr) ...)) — structured concurrency
        let tgp = after_tag(node, 0)
        tgp = skip_ws(node, tgp)
        let tg_body = child_at(node, tgp)
        out = sb_new()
        sb_append(out, emit_indent("", indent))
        sb_append(out, "{ /* task_group */\n")
        sb_append(out, emit_indent("", indent + 1))
        sb_append(out, "LcnTaskGroup *__lcn_tg = lcn_task_group_new();\n")
        let tg_btag = node_tag(tg_body, 0)
        if str_eq(tg_btag, "block") {
            let tgbp = after_tag(tg_body, 0)
            let tgblen = str_len(tg_body)
            for _tg in 0..200 {
                tgbp = skip_ws(tg_body, tgbp)
                if tgbp >= tgblen - 1 { break }
                if char_code(char_at(tg_body, tgbp)) == 41 { break }
                let tg_stmt = child_at(tg_body, tgbp)
                tgbp = skip_child(tg_body, tgbp)
                let tgs_tag = node_tag(tg_stmt, 0)
                if str_eq(tgs_tag, "spawn") {
                    sb_append(out, emit_indent("", indent + 1))
                    sb_append(out, "lcn_task_group_spawn(__lcn_tg, (LcnTaskFn)NULL, NULL);\n")
                } else {
                    let tg_res = emit_stmt(svars, tg_stmt, indent + 1)
                    sb_append(out, unpack_code(tg_res))
                }
            }
        }
        sb_append(out, emit_indent("", indent + 1))
        sb_append(out, "void **__lcn_tg_results = lcn_task_group_await_all(__lcn_tg);\n")
        sb_append(out, emit_indent("", indent + 1))
        sb_append(out, "lcn_task_group_free(__lcn_tg);\n")
        sb_append(out, emit_indent("", indent))
        sb_append(out, "}\n")

    } else if str_eq(tag, "spawn") {
        // (spawn body) -> as statement, emit spawn wrapper + call
        // Green threads dispatch: check env var LCN_GREEN_THREADS
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let body = child_at(node, p)
        out = sb_new()
        sb_append(out, emit_indent("", indent))
        let use_green_raw = env("LCN_GREEN_THREADS")
        let use_green = "0"
        if str_len(use_green_raw) > 0 {
            use_green = use_green_raw
        }
        if str_eq(use_green, "1") {
            sb_append(out, "/* spawn (green) */ lcn_green_spawn((void *(*)(void *))NULL, NULL);\n")
        } else {
            sb_append(out, "/* spawn */ lcn_spawn_task((LcnTaskFn)NULL, NULL);\n")
        }

    } else {
        // Expression statement
        out = sb_new()
        sb_append(out, emit_indent("", indent))
        sb_append(out, emit_expr(svars, node))
        sb_append(out, ";\n")
    }

    pack_sc(new_svars, sb_to_string(out))
}

// Helper: trim leading whitespace from a string
fn str_trim_left(s: string) -> string {
    let p = 0
    let slen = str_len(s)
    for _t in 0..10000 {
        if p >= slen { break }
        let c = char_code(char_at(s, p))
        if c == 32 { p = p + 1
        } else if c == 9 { p = p + 1
        } else { break }
    }
    str_slice(s, p, slen)
}

// ── Block Code Generation ───────────────────────────────────
// emit_block emits a (block ...) node as { ... } with braces
// Returns packed svars + code

fn emit_block(svars: string, node: string, indent: int) -> string {
    let out = sb_new()
    sb_append(out, "{\n")
    let inner = emit_block_inner(svars, node, indent + 1)
    let new_svars = unpack_svars(inner)
    sb_append(out, unpack_code(inner))
    sb_append(out, emit_indent("", indent))
    sb_append(out, "}")
    pack_sc(new_svars, sb_to_string(out))
}

// emit_block_inner emits the contents of a (block ...) without braces
fn emit_block_inner(svars: string, node: string, indent: int) -> string {
    let tag = node_tag(node, 0)
    let out = sb_new()
    let cur_svars = svars

    if str_eq(tag, "block") {
        let p = after_tag(node, 0)
        let nlen = str_len(node)
        for _bs in 0..5000 {
            p = skip_ws(node, p)
            if p >= nlen - 1 { break }
            if char_code(char_at(node, p)) == 41 { break }
            let stmt = child_at(node, p)
            if str_len(stmt) == 0 { break }
            let result = emit_stmt(cur_svars, stmt, indent)
            cur_svars = unpack_svars(result)
            sb_append(out, unpack_code(result))
            // Bump closure counter for any closures in this statement
            let nc = count_closures_in(stmt)
            for _bci in 0..nc {
                cur_svars = bump_closure_id(cur_svars)
            }
            p = skip_child(node, p)
        }
    } else {
        // Single expression as body
        let result = emit_stmt(cur_svars, node, indent)
        cur_svars = unpack_svars(result)
        sb_append(out, unpack_code(result))
        // Bump closure counter for any closures
        let nc = count_closures_in(node)
        for _bci in 0..nc {
            cur_svars = bump_closure_id(cur_svars)
        }
    }

    pack_sc(cur_svars, sb_to_string(out))
}

// ── Function Declaration Generation ─────────────────────────

fn emit_fn(svars: string, node: string) -> string {
    // (fn name (params (pname [:type]) ...) [->rettype] (block ...))
    let p = after_tag(node, 0)
    p = skip_ws(node, p)
    let name = read_word(node, p)
    p = p + str_len(name)
    p = skip_ws(node, p)

    // Parse params
    let params_node = child_at(node, p)
    p = skip_child(node, p)
    p = skip_ws(node, p)

    // Check for return type: ->type
    let ret_type = "void"
    let nlen = str_len(node)
    if p < nlen {
        let next = read_word(node, p)
        if str_len(next) > 0 {
            let c0 = char_code(char_at(next, 0))
            if c0 == 45 {
                // Starts with '-' — this is ->type
                // Remove the leading ->
                if str_len(next) > 2 {
                    ret_type = map_type(str_slice(next, 2, str_len(next)))
                } else {
                    // -> followed by space, next word is type
                    p = p + str_len(next)
                    p = skip_ws(node, p)
                    let rty = read_word(node, p)
                    ret_type = map_type(rty)
                    p = p + str_len(rty)
                }
                if str_len(next) > 2 {
                    p = p + str_len(next)
                }
                p = skip_ws(node, p)
            } else if c0 == 40 {
                // It's the body block already
                ret_type = "void"
            }
        }
    }

    let is_main = str_eq(name, "main")

    // Build function header
    let out = sb_new()
    sb_append(out, "static ")
    sb_append(out, ret_type)
    sb_append(out, " lcn_")
    sb_append(out, name)
    sb_append(out, "(")

    // Parse parameter list
    let fn_svars = svars
    let param_sb = sb_new()
    let param_count = 0
    let ptag = node_tag(params_node, 0)
    if str_eq(ptag, "params") {
        let pp = after_tag(params_node, 0)
        let plen = str_len(params_node)
        for _fp in 0..50 {
            pp = skip_ws(params_node, pp)
            if pp >= plen - 1 { break }
            if char_code(char_at(params_node, pp)) == 41 { break }
            let param = child_at(params_node, pp)
            pp = skip_child(params_node, pp)
            // param is "(name [:type])"
            let prp = 0
            let prlen = str_len(param)
            // Skip opening paren if present
            if prlen > 0 {
                if char_code(char_at(param, 0)) == 40 {
                    prp = 1
                }
            }
            prp = skip_ws(param, prp)
            let pname = read_word(param, prp)
            prp = prp + str_len(pname)
            prp = skip_ws(param, prp)
            let pty = "int64_t"
            if prp < prlen {
                if char_code(char_at(param, prp)) == 58 {
                    prp = prp + 1
                    let ptname = read_word(param, prp)
                    pty = map_type(ptname)
                }
            }
            if param_count > 0 {
                sb_append(param_sb, ", ")
            }
            sb_append(param_sb, pty)
            sb_append(param_sb, " ")
            sb_append(param_sb, pname)
            param_count = param_count + 1
            // Track string params
            if str_eq(pty, "LcnString") {
                fn_svars = add_string_var(fn_svars, pname)
            }
        }
    }
    if param_count == 0 {
        sb_append(out, "void")
    } else {
        sb_append(out, sb_to_string(param_sb))
    }
    sb_append(out, ") ")

    // Emit body
    let body_node = child_at(node, p)
    let body_tag = node_tag(body_node, 0)

    let ret_is_result = str_eq(ret_type, "LcnResult")

    if str_eq(body_tag, "block") {
        // Emit block with potential implicit return
        sb_append(out, "{\n")
        let bp = after_tag(body_node, 0)
        let blen = str_len(body_node)

        // Collect all statements
        let stmts = sb_new()
        let stmt_count = 0
        let cur_svars = fn_svars
        let stmt_positions = sb_new()
        for _bs in 0..5000 {
            bp = skip_ws(body_node, bp)
            if bp >= blen - 1 { break }
            if char_code(char_at(body_node, bp)) == 41 { break }
            let stmt = child_at(body_node, bp)
            if str_len(stmt) == 0 { break }
            bp = skip_child(body_node, bp)

            // Check if this is the last stmt
            let next_bp = skip_ws(body_node, bp)
            let is_last = false
            if next_bp >= blen - 1 {
                is_last = true
            } else if char_code(char_at(body_node, next_bp)) == 41 {
                is_last = true
            }

            if is_last {
                // Last statement — check for implicit return
                let stmt_tag = node_tag(stmt, 0)
                if str_eq(stmt_tag, "return") {
                    // Explicit return — emit as-is
                    let result = emit_stmt(cur_svars, stmt, 1)
                    cur_svars = unpack_svars(result)
                    sb_append(out, unpack_code(result))
                } else if ret_is_result {
                    // Result fn: emit stmt, then return LCN_OK
                    let result = emit_stmt(cur_svars, stmt, 1)
                    cur_svars = unpack_svars(result)
                    sb_append(out, unpack_code(result))
                    sb_append(out, "    return LCN_OK;\n")
                } else if str_eq(ret_type, "void") {
                    let result = emit_stmt(cur_svars, stmt, 1)
                    cur_svars = unpack_svars(result)
                    sb_append(out, unpack_code(result))
                } else {
                    // Non-void return: implicit return of last expression
                    let stmt_tag2 = node_tag(stmt, 0)
                    // If it's a simple expression (not let/assign/if/for/etc),
                    // emit "return expr;" directly
                    let is_expr_stmt = false
                    if str_eq(stmt_tag2, "call") { is_expr_stmt = true
                    } else if str_eq(stmt_tag2, "ident") { is_expr_stmt = true
                    } else if str_eq(stmt_tag2, "int") { is_expr_stmt = true
                    } else if str_eq(stmt_tag2, "float") { is_expr_stmt = true
                    } else if str_eq(stmt_tag2, "string") { is_expr_stmt = true
                    } else if str_eq(stmt_tag2, "bool") { is_expr_stmt = true
                    } else if str_eq(stmt_tag2, "+") { is_expr_stmt = true
                    } else if str_eq(stmt_tag2, "-") { is_expr_stmt = true
                    } else if str_eq(stmt_tag2, "*") { is_expr_stmt = true
                    } else if str_eq(stmt_tag2, "/") { is_expr_stmt = true
                    } else if str_eq(stmt_tag2, "method") { is_expr_stmt = true
                    }
                    if is_expr_stmt {
                        sb_append(out, "    return ")
                        sb_append(out, emit_expr(cur_svars, stmt))
                        sb_append(out, ";\n")
                    } else {
                        let result = emit_stmt(cur_svars, stmt, 1)
                        cur_svars = unpack_svars(result)
                        sb_append(out, unpack_code(result))
                    }
                }
            } else {
                let result = emit_stmt(cur_svars, stmt, 1)
                cur_svars = unpack_svars(result)
                sb_append(out, unpack_code(result))
            }
            stmt_count = stmt_count + 1
        }

        // If no statements and Result return, add return LCN_OK
        if stmt_count == 0 {
            if ret_is_result {
                sb_append(out, "    return LCN_OK;\n")
            }
        }
        sb_append(out, "}\n\n")
    } else {
        sb_append(out, "{ }\n\n")
    }

    sb_to_string(out)
}

// ── Agent Declaration Generation ────────────────────────────
// Simplified: emit struct + constructor

fn emit_agent(svars: string, node: string) -> string {
    let p = after_tag(node, 0)
    p = skip_ws(node, p)
    let name = read_word(node, p)
    p = p + str_len(name)

    let out = sb_new()

    // Emit struct
    sb_append(out, "typedef struct {\n")
    sb_append(out, "    LcnString model;\n")
    sb_append(out, "    LcnString prompt;\n")
    sb_append(out, "    LcnString endpoint;\n")
    sb_append(out, "    LcnString api_key;\n")
    sb_append(out, "    LcnBudget budget;\n")
    sb_append(out, "    LcnCapability capabilities;\n")
    sb_append(out, "} Agent_")
    sb_append(out, name)
    sb_append(out, ";\n\n")

    // Collect field values for constructor
    let model_val = "\"gpt-4\""
    let prompt_val = "\"\""
    let endpoint_val = "NULL"

    let nlen = str_len(node)
    for _af in 0..200 {
        p = skip_ws(node, p)
        if p >= nlen - 1 { break }
        if char_code(char_at(node, p)) == 41 { break }
        let child = child_at(node, p)
        p = skip_child(node, p)
        let ctag = node_tag(child, 0)
        if str_eq(ctag, "field") {
            let fp = after_tag(child, 0)
            fp = skip_ws(child, fp)
            let fname = read_word(child, fp)
            fp = fp + str_len(fname)
            fp = skip_ws(child, fp)
            let fval = child_at(child, fp)
            if str_eq(fname, "model") {
                model_val = emit_expr(svars, fval)
            } else if str_eq(fname, "prompt") {
                prompt_val = emit_expr(svars, fval)
            } else if str_eq(fname, "endpoint") {
                endpoint_val = emit_expr(svars, fval)
            }
        }
    }

    // Emit constructor
    sb_append(out, "static Agent_")
    sb_append(out, name)
    sb_append(out, " lcn_agent_")
    sb_append(out, name)
    sb_append(out, "_new(void) {\n")
    sb_append(out, "    return (Agent_")
    sb_append(out, name)
    sb_append(out, "){\n")
    sb_append(out, "        .model = ")
    sb_append(out, model_val)
    sb_append(out, ",\n")
    sb_append(out, "        .prompt = ")
    sb_append(out, prompt_val)
    sb_append(out, ",\n")
    sb_append(out, "        .endpoint = ")
    sb_append(out, endpoint_val)
    sb_append(out, ",\n")
    sb_append(out, "        .api_key = NULL,\n")
    sb_append(out, "        .budget = {0},\n")
    sb_append(out, "        .capabilities = (LcnCapability)0\n")
    sb_append(out, "    };\n")
    sb_append(out, "}\n\n")

    sb_to_string(out)
}

// ── AST Feature Detection ───────────────────────────────────
// Scan the top-level S-expression to detect if agents/drivers/MCP are present.
// Returns true if the program needs the full runtime header.

fn needs_runtime(ast: string) -> bool {
    let r = false
    // Check for agent, capability, budget, tool, guard, router, mesh, supervisor, mcp
    if str_find(ast, "(agent ") >= 0 { r = true
    } else if str_find(ast, "(capability ") >= 0 { r = true
    } else if str_find(ast, "(budget ") >= 0 { r = true
    } else if str_find(ast, "(tool ") >= 0 { r = true
    } else if str_find(ast, "(guard ") >= 0 { r = true
    } else if str_find(ast, "(router ") >= 0 { r = true
    } else if str_find(ast, "(mesh ") >= 0 { r = true
    } else if str_find(ast, "(supervisor ") >= 0 { r = true
    } else if str_find(ast, "(memory ") >= 0 { r = true
    } else if str_find(ast, "(channel ") >= 0 { r = true
    } else if str_find(ast, "(ask") >= 0 { r = true
    } else if str_find(ast, "(tell ") >= 0 { r = true
    } else if str_find(ast, "(use a2a") >= 0 { r = true
    } else if str_find(ast, "(task_group") >= 0 { r = true
    } else if str_find(ast, "(interface ") >= 0 { r = true
    } else if str_find(ast, "(spawn") >= 0 { r = true
    }
    // Also check for builtins that need runtime: vec ops, string utils, file I/O, sb
    if r == false {
        if str_find(ast, "vec_push") >= 0 { r = true
        } else if str_find(ast, "vec_new") >= 0 { r = true
        } else if str_find(ast, "vec_get") >= 0 { r = true
        } else if str_find(ast, "vec_len") >= 0 { r = true
        } else if str_find(ast, "sb_new") >= 0 { r = true
        } else if str_find(ast, "sb_append") >= 0 { r = true
        } else if str_find(ast, "sb_to_string") >= 0 { r = true
        } else if str_find(ast, "read_file") >= 0 { r = true
        } else if str_find(ast, "write_file") >= 0 { r = true
        } else if str_find(ast, "read_line") >= 0 { r = true
        } else if str_find(ast, "str_find") >= 0 { r = true
        } else if str_find(ast, "str_slice") >= 0 { r = true
        } else if str_find(ast, "str_replace") >= 0 { r = true
        } else if str_find(ast, "str_trim") >= 0 { r = true
        } else if str_find(ast, "char_at") >= 0 { r = true
        } else if str_find(ast, "char_code") >= 0 { r = true
        } else if str_find(ast, "str_char_is") >= 0 { r = true
        } else if str_find(ast, "str_from_code") >= 0 { r = true
        } else if str_find(ast, "json_parse") >= 0 { r = true
        } else if str_find(ast, "json_get") >= 0 { r = true
        } else if str_find(ast, "env(") >= 0 { r = true
        } else if str_find(ast, "env_or") >= 0 { r = true
        } else if str_find(ast, "arg(") >= 0 { r = true
        } else if str_find(ast, "arg_count") >= 0 { r = true
        } else if str_find(ast, "now_ms") >= 0 { r = true
        } else if str_find(ast, "sleep_ms") >= 0 { r = true
        } else if str_find(ast, "format") >= 0 { r = true
        } else if str_find(ast, "sql_escape") >= 0 { r = true
        } else if str_find(ast, "secret_") >= 0 { r = true
        }
    }
    r
}

// ── C Preamble ──────────────────────────────────────────────

fn emit_preamble_standalone() -> string {
    let out = sb_new()
    sb_append(out, "/* Generated by Limceron Stage 1 codegen */\n")
    sb_append(out, "#include <stdio.h>\n")
    sb_append(out, "#include <stdlib.h>\n")
    sb_append(out, "#include <string.h>\n")
    sb_append(out, "#include <stdbool.h>\n")
    sb_append(out, "#include <stdint.h>\n\n")
    sb_append(out, "typedef const char* LcnString;\n")
    sb_append(out, "typedef int64_t LcnInt;\n\n")
    sb_append(out, "/* Minimal string helpers */\n")
    sb_append(out, "static LcnString lcn_str_concat(LcnString a, LcnString b) {\n")
    sb_append(out, "    size_t la = a ? strlen(a) : 0, lb = b ? strlen(b) : 0;\n")
    sb_append(out, "    char *r = (char *)malloc(la + lb + 1);\n")
    sb_append(out, "    if (la) memcpy(r, a, la);\n")
    sb_append(out, "    if (lb) memcpy(r + la, b, lb);\n")
    sb_append(out, "    r[la + lb] = 0;\n")
    sb_append(out, "    return r;\n")
    sb_append(out, "}\n")
    sb_append(out, "static LcnString lcn_str_from_int(int64_t v) {\n")
    sb_append(out, "    char buf[32]; snprintf(buf, sizeof(buf), \"%lld\", (long long)v);\n")
    sb_append(out, "    return strdup(buf);\n")
    sb_append(out, "}\n\n")
    sb_append(out, "/* Forward declarations */\n")
    sb_append(out, "static int _lcn_argc;\n")
    sb_append(out, "static char **_lcn_argv;\n\n")
    sb_to_string(out)
}

fn emit_preamble_runtime() -> string {
    let out = sb_new()
    sb_append(out, "/* Generated by Limceron Stage 1 codegen */\n")
    sb_append(out, "#include \"lcn_runtime.h\"\n\n")
    sb_append(out, "/* Forward declarations */\n")
    sb_append(out, "static int _lcn_argc;\n")
    sb_append(out, "static char **_lcn_argv;\n\n")
    sb_to_string(out)
}

fn emit_preamble(use_runtime: bool) -> string {
    let r = ""
    if use_runtime {
        r = emit_preamble_runtime()
    } else {
        r = emit_preamble_standalone()
    }
    r
}

// ── Main Entry Point Generation ─────────────────────────────

fn emit_main_wrapper(has_main: bool, ret_type: string) -> string {
    let out = sb_new()
    if has_main {
        sb_append(out, "int main(int argc, char **argv) {\n")
        sb_append(out, "    _lcn_argc = argc;\n")
        sb_append(out, "    _lcn_argv = argv;\n")
        if str_eq(ret_type, "LcnResult") {
            sb_append(out, "    LcnResult _res = lcn_main();\n")
            sb_append(out, "    if (!_res.ok) {\n")
            sb_append(out, "        fprintf(stderr, \"Error: %s\\n\", _res.error ? _res.error : \"unknown\");\n")
            sb_append(out, "        return 1;\n")
            sb_append(out, "    }\n")
            sb_append(out, "    return 0;\n")
        } else {
            sb_append(out, "    lcn_main();\n")
            sb_append(out, "    return 0;\n")
        }
        sb_append(out, "}\n")
    }
    sb_to_string(out)
}

// ── Program Generation (Top-Level) ──────────────────────────

// ── Agent Name Tracking ─────────────────────────────────────
// Track agent names as newline-separated string for method call resolution.
// Format: "AgentName1\nAgentName2\n"

fn is_agent_name(agents: string, name: string) -> bool {
    let r = false
    if str_len(name) == 0 {
        r = false
    } else {
        let needle = name + "\n"
        let idx = str_find(agents, needle)
        if idx >= 0 {
            if idx == 0 {
                r = true
            } else {
                let prev = char_at(agents, idx - 1)
                if char_code(prev) == 10 {
                    r = true
                }
            }
        }
    }
    r
}

// Track agent methods as "AgentName.method\n" for self-call detection.
fn is_agent_method(agent_methods: string, agent_name: string, method_name: string) -> bool {
    let needle = agent_name + "." + method_name + "\n"
    let idx = str_find(agent_methods, needle)
    idx >= 0
}

// ── Closure Deferred Definitions ────────────────────────────
// We track closure definitions in a string buffer that gets emitted
// before the function that uses them. Since globals can't be mutable,
// we thread closure defs through the program generation.

// Global closure counter encoded as a string to thread through calls.
// We use a simple approach: emit closure stubs as static functions
// using unique names based on a counter we carry through emit_program.

fn emit_closure_fn(svars: string, node: string, closure_id: int) -> string {
    // (closure (params (pname [:type]) ...) [->rettype] (block ...))
    let p = after_tag(node, 0)
    p = skip_ws(node, p)
    let params_node = child_at(node, p)
    p = skip_child(node, p)
    p = skip_ws(node, p)

    // Check for return type: ->type
    let closure_ret = "int64_t"
    let nlen = str_len(node)
    if p < nlen {
        let next = read_word(node, p)
        if str_len(next) > 0 {
            let c0 = char_code(char_at(next, 0))
            if c0 == 45 {
                if str_len(next) > 2 {
                    closure_ret = map_type(str_slice(next, 2, str_len(next)))
                }
                p = p + str_len(next)
                p = skip_ws(node, p)
            }
        }
    }
    let body_node = child_at(node, p)
    let cid_str = to_string(closure_id)

    let out = sb_new()

    // Emit the closure function definition
    sb_append(out, "static ")
    sb_append(out, closure_ret)
    sb_append(out, " _lcn_closure_")
    sb_append(out, cid_str)
    sb_append(out, "_fn(void *_env")

    // Parse params
    let ptag = node_tag(params_node, 0)
    let fn_svars = svars
    if str_eq(ptag, "params") {
        let pp = after_tag(params_node, 0)
        let plen = str_len(params_node)
        for _fp in 0..50 {
            pp = skip_ws(params_node, pp)
            if pp >= plen - 1 { break }
            if char_code(char_at(params_node, pp)) == 41 { break }
            let param = child_at(params_node, pp)
            pp = skip_child(params_node, pp)
            let prp = 0
            let prlen = str_len(param)
            if prlen > 0 {
                if char_code(char_at(param, 0)) == 40 {
                    prp = 1
                }
            }
            prp = skip_ws(param, prp)
            let pname = read_word(param, prp)
            prp = prp + str_len(pname)
            prp = skip_ws(param, prp)
            let pty = "int64_t"
            if prp < prlen {
                if char_code(char_at(param, prp)) == 58 {
                    prp = prp + 1
                    let ptname = read_word(param, prp)
                    pty = map_type(ptname)
                }
            }
            sb_append(out, ", ")
            sb_append(out, pty)
            sb_append(out, " ")
            sb_append(out, pname)
            if str_eq(pty, "LcnString") {
                fn_svars = add_string_var(fn_svars, pname)
            }
        }
    }
    sb_append(out, ") ")

    // Emit body
    let body_tag = node_tag(body_node, 0)
    if str_eq(body_tag, "block") {
        sb_append(out, "{\n")
        let bp = after_tag(body_node, 0)
        let blen = str_len(body_node)
        let cur_svars = fn_svars
        let stmt_count = 0
        for _bs in 0..5000 {
            bp = skip_ws(body_node, bp)
            if bp >= blen - 1 { break }
            if char_code(char_at(body_node, bp)) == 41 { break }
            let stmt = child_at(body_node, bp)
            if str_len(stmt) == 0 { break }
            bp = skip_child(body_node, bp)

            let next_bp = skip_ws(body_node, bp)
            let is_last = false
            if next_bp >= blen - 1 {
                is_last = true
            } else if char_code(char_at(body_node, next_bp)) == 41 {
                is_last = true
            }

            if is_last {
                // Last stmt: implicit return
                let stmt_tag = node_tag(stmt, 0)
                if str_eq(stmt_tag, "return") {
                    let result = emit_stmt(cur_svars, stmt, 1)
                    cur_svars = unpack_svars(result)
                    sb_append(out, unpack_code(result))
                } else {
                    // Check if it's a returnable expression
                    let is_expr_stmt = false
                    if str_eq(stmt_tag, "call") { is_expr_stmt = true
                    } else if str_eq(stmt_tag, "ident") { is_expr_stmt = true
                    } else if str_eq(stmt_tag, "int") { is_expr_stmt = true
                    } else if str_eq(stmt_tag, "float") { is_expr_stmt = true
                    } else if str_eq(stmt_tag, "string") { is_expr_stmt = true
                    } else if str_eq(stmt_tag, "bool") { is_expr_stmt = true
                    } else if str_eq(stmt_tag, "+") { is_expr_stmt = true
                    } else if str_eq(stmt_tag, "-") { is_expr_stmt = true
                    } else if str_eq(stmt_tag, "*") { is_expr_stmt = true
                    } else if str_eq(stmt_tag, "/") { is_expr_stmt = true
                    }
                    if is_expr_stmt {
                        sb_append(out, "    return ")
                        sb_append(out, emit_expr(cur_svars, stmt))
                        sb_append(out, ";\n")
                    } else {
                        let result = emit_stmt(cur_svars, stmt, 1)
                        cur_svars = unpack_svars(result)
                        sb_append(out, unpack_code(result))
                    }
                }
            } else {
                let result = emit_stmt(cur_svars, stmt, 1)
                cur_svars = unpack_svars(result)
                sb_append(out, unpack_code(result))
            }
            stmt_count = stmt_count + 1
        }
        sb_append(out, "}\n\n")
    } else if str_len(body_node) > 0 {
        // Single expression body
        sb_append(out, "{\n    return ")
        sb_append(out, emit_expr(fn_svars, body_node))
        sb_append(out, ";\n}\n\n")
    } else {
        sb_append(out, "{ }\n\n")
    }

    sb_to_string(out)
}

// ── Scan for closures in a function body ────────────────────
// Returns the number of closures found and emits their definitions

fn count_closures_in(node: string) -> int {
    let count = 0
    let pos = 0
    let nlen = str_len(node)
    for _sc in 0..10000 {
        if pos >= nlen { break }
        let idx = str_find(str_slice(node, pos, nlen), "(closure ")
        if idx < 0 { break }
        count = count + 1
        pos = pos + idx + 9
    }
    count
}

// ── Agent Method Emission ───────────────────────────────────
// Emit agent methods as static functions with self parameter

fn emit_agent_method(svars: string, agent_name: string, fn_node: string, agent_methods: string) -> string {
    // fn_node is (fn methodname (params ...) [->rettype] (block ...))
    let p = after_tag(fn_node, 0)
    p = skip_ws(fn_node, p)
    let method_name = read_word(fn_node, p)
    p = p + str_len(method_name)
    p = skip_ws(fn_node, p)

    // Parse params
    let params_node = child_at(fn_node, p)
    p = skip_child(fn_node, p)
    p = skip_ws(fn_node, p)

    // Check for return type
    let ret_type = "void"
    let nlen = str_len(fn_node)
    if p < nlen {
        let next = read_word(fn_node, p)
        if str_len(next) > 0 {
            let c0 = char_code(char_at(next, 0))
            if c0 == 45 {
                if str_len(next) > 2 {
                    ret_type = map_type(str_slice(next, 2, str_len(next)))
                } else {
                    p = p + str_len(next)
                    p = skip_ws(fn_node, p)
                    let rty = read_word(fn_node, p)
                    ret_type = map_type(rty)
                    p = p + str_len(rty)
                }
                if str_len(next) > 2 {
                    p = p + str_len(next)
                }
                p = skip_ws(fn_node, p)
            } else if c0 == 40 {
                ret_type = "void"
            }
        }
    }

    let out = sb_new()
    sb_append(out, "static ")
    sb_append(out, ret_type)
    sb_append(out, " lcn_agent_")
    sb_append(out, agent_name)
    sb_append(out, "_")
    sb_append(out, method_name)
    sb_append(out, "(Agent_")
    sb_append(out, agent_name)
    sb_append(out, " *self")

    // Parse parameter list
    let fn_svars = svars
    let ptag = node_tag(params_node, 0)
    if str_eq(ptag, "params") {
        let pp = after_tag(params_node, 0)
        let plen = str_len(params_node)
        for _fp in 0..50 {
            pp = skip_ws(params_node, pp)
            if pp >= plen - 1 { break }
            if char_code(char_at(params_node, pp)) == 41 { break }
            let param = child_at(params_node, pp)
            pp = skip_child(params_node, pp)
            let prp = 0
            let prlen = str_len(param)
            if prlen > 0 {
                if char_code(char_at(param, 0)) == 40 {
                    prp = 1
                }
            }
            prp = skip_ws(param, prp)
            let pname = read_word(param, prp)
            prp = prp + str_len(pname)
            prp = skip_ws(param, prp)
            let pty = "int64_t"
            if prp < prlen {
                if char_code(char_at(param, prp)) == 58 {
                    prp = prp + 1
                    let ptname = read_word(param, prp)
                    pty = map_type(ptname)
                }
            }
            sb_append(out, ", ")
            sb_append(out, pty)
            sb_append(out, " ")
            sb_append(out, pname)
            if str_eq(pty, "LcnString") {
                fn_svars = add_string_var(fn_svars, pname)
            }
        }
    }
    sb_append(out, ") ")

    // Emit body — rewrite ask() calls to use agent's model/endpoint/prompt
    let body_node = child_at(fn_node, p)
    let body_tag = node_tag(body_node, 0)
    let ret_is_result = str_eq(ret_type, "LcnResult")

    if str_eq(body_tag, "block") {
        sb_append(out, "{\n")
        let bp = after_tag(body_node, 0)
        let blen = str_len(body_node)
        let cur_svars = fn_svars
        let stmt_count = 0
        for _bs in 0..5000 {
            bp = skip_ws(body_node, bp)
            if bp >= blen - 1 { break }
            if char_code(char_at(body_node, bp)) == 41 { break }
            let stmt = child_at(body_node, bp)
            if str_len(stmt) == 0 { break }
            bp = skip_child(body_node, bp)

            let next_bp = skip_ws(body_node, bp)
            let is_last = false
            if next_bp >= blen - 1 {
                is_last = true
            } else if char_code(char_at(body_node, next_bp)) == 41 {
                is_last = true
            }

            // Rewrite ask nodes inside agent methods
            let stmt_code = emit_agent_stmt(cur_svars, stmt, 1, agent_name, agent_methods)
            cur_svars = unpack_svars(stmt_code)

            if is_last {
                let stmt_tag = node_tag(stmt, 0)
                if str_eq(stmt_tag, "return") {
                    sb_append(out, unpack_code(stmt_code))
                } else if ret_is_result {
                    sb_append(out, unpack_code(stmt_code))
                    sb_append(out, "    return LCN_OK;\n")
                } else if str_eq(ret_type, "void") {
                    sb_append(out, unpack_code(stmt_code))
                } else {
                    // Implicit return for non-void
                    let stmt_tag2 = node_tag(stmt, 0)
                    let is_expr_stmt = false
                    if str_eq(stmt_tag2, "call") { is_expr_stmt = true
                    } else if str_eq(stmt_tag2, "ident") { is_expr_stmt = true
                    } else if str_eq(stmt_tag2, "ask") { is_expr_stmt = true
                    } else if str_eq(stmt_tag2, "string") { is_expr_stmt = true
                    } else if str_eq(stmt_tag2, "+") { is_expr_stmt = true
                    }
                    if is_expr_stmt {
                        sb_append(out, "    return ")
                        sb_append(out, emit_agent_expr(cur_svars, stmt, agent_name, agent_methods))
                        sb_append(out, ";\n")
                    } else {
                        sb_append(out, unpack_code(stmt_code))
                    }
                }
            } else {
                sb_append(out, unpack_code(stmt_code))
            }
            stmt_count = stmt_count + 1
        }
        if stmt_count == 0 {
            if ret_is_result {
                sb_append(out, "    return LCN_OK;\n")
            }
        }
        sb_append(out, "}\n\n")
    } else {
        sb_append(out, "{ }\n\n")
    }

    sb_to_string(out)
}

// ── Agent-aware expression emission ─────────────────────────
// Rewrites ask() to pass agent's model/endpoint/prompt, and
// rewrites sibling method calls to lcn_agent_Name_method(&self, ...)

fn emit_agent_expr(svars: string, node: string, agent_name: string, agent_methods: string) -> string {
    let tag = node_tag(node, 0)
    let r = ""
    if str_eq(tag, "ask") {
        // Rewrite ask(msg) to lcn_ask_typed(self->model, self->endpoint, self->prompt, msg, NULL, NULL, NULL)
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let nlen = str_len(node)
        let out = sb_new()
        sb_append(out, "lcn_ask_typed(self->model, self->endpoint, self->prompt, ")
        if p < nlen - 1 {
            let arg_node = child_at(node, p)
            if str_len(arg_node) > 0 {
                sb_append(out, emit_expr(svars, arg_node))
            } else {
                sb_append(out, "\"\"")
            }
        } else {
            sb_append(out, "\"\"")
        }
        sb_append(out, ", NULL, NULL, NULL)")
        r = sb_to_string(out)
    } else if str_eq(tag, "call") {
        // Check if it's a sibling agent method call
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let fname = read_word(node, p)
        if is_agent_method(agent_methods, agent_name, fname) {
            // Rewrite to lcn_agent_Name_method(self, args...)
            let out = sb_new()
            sb_append(out, "lcn_agent_")
            sb_append(out, agent_name)
            sb_append(out, "_")
            sb_append(out, fname)
            sb_append(out, "(self")
            p = p + str_len(fname)
            let nlen2 = str_len(node)
            for _ca in 0..100 {
                p = skip_ws(node, p)
                if p >= nlen2 - 1 { break }
                if char_code(char_at(node, p)) == 41 { break }
                let arg_node = child_at(node, p)
                if str_len(arg_node) == 0 { break }
                sb_append(out, ", ")
                sb_append(out, emit_expr(svars, arg_node))
                p = skip_child(node, p)
            }
            sb_append(out, ")")
            r = sb_to_string(out)
        } else if is_sensitive(fname) {
            // Defense-in-depth: wrap sensitive calls with capability check inside agent methods
            let out = sb_new()
            sb_append(out, "(lcn_capability_check_tool(\"")
            sb_append(out, fname)
            sb_append(out, "\", NULL, 0) ? (lcn_")
            sb_append(out, fname)
            sb_append(out, "(")
            p = p + str_len(fname)
            let nlen3 = str_len(node)
            let darg_count = 0
            for _da in 0..100 {
                p = skip_ws(node, p)
                if p >= nlen3 - 1 { break }
                if char_code(char_at(node, p)) == 41 { break }
                let darg_node = child_at(node, p)
                if str_len(darg_node) == 0 { break }
                if darg_count > 0 {
                    sb_append(out, ", ")
                }
                sb_append(out, emit_expr(svars, darg_node))
                darg_count = darg_count + 1
                p = skip_child(node, p)
            }
            sb_append(out, ")) : (fprintf(stderr, \"capability denied: ")
            sb_append(out, fname)
            sb_append(out, "\\n\"), (void *)0))")
            r = sb_to_string(out)
        } else {
            r = emit_expr(svars, node)
        }
    } else {
        r = emit_expr(svars, node)
    }
    r
}

// Agent-aware statement emission
fn emit_agent_stmt(svars: string, node: string, indent: int, agent_name: string, agent_methods: string) -> string {
    let tag = node_tag(node, 0)
    let result = ""

    // For let statements with ask/agent-method initializers, rewrite the expression
    if str_eq(tag, "let") {
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let name = read_word(node, p)
        p = p + str_len(name)
        p = skip_ws(node, p)

        let ty = ""
        let nlen = str_len(node)
        if p < nlen {
            let next_c = char_at(node, p)
            if char_code(next_c) == 58 {
                p = p + 1
                ty = read_word(node, p)
                p = p + str_len(ty)
                p = skip_ws(node, p)
            }
        }

        let has_init = false
        if p < nlen - 1 {
            let cc = char_code(char_at(node, p))
            if cc != 41 {
                has_init = true
            }
        }

        if has_init {
            let init_node = child_at(node, p)
            let init_code = emit_agent_expr(svars, init_node, agent_name, agent_methods)
            let c_type = ""
            if str_len(ty) > 0 {
                c_type = map_type(ty)
            } else {
                c_type = infer_type(svars, init_node)
            }

            let out = sb_new()
            sb_append(out, emit_indent("", indent))
            sb_append(out, c_type)
            sb_append(out, " ")
            sb_append(out, name)
            sb_append(out, " = ")
            sb_append(out, init_code)
            sb_append(out, ";\n")

            let new_svars = svars
            let is_str = false
            if str_eq(c_type, "LcnString") {
                is_str = true
            } else if might_be_string(svars, init_node) {
                is_str = true
            }
            if is_str {
                new_svars = add_string_var(svars, name)
            }
            result = pack_sc(new_svars, sb_to_string(out))
        } else {
            result = emit_stmt(svars, node, indent)
        }
    } else {
        // For expression statements that are ask/agent-method calls
        let out = sb_new()
        sb_append(out, emit_indent("", indent))
        sb_append(out, emit_agent_expr(svars, node, agent_name, agent_methods))
        sb_append(out, ";\n")
        result = pack_sc(svars, sb_to_string(out))
    }
    result
}

// ── Function Return Type Pre-scan ────────────────────────────
// Pre-scan to collect which user-defined functions return string.
// Stored as "fname\n" for string-returning functions.

fn prescan_fn_ret_types(ast: string) -> string {
    let str_fns = ""
    let tag = node_tag(ast, 0)
    if str_eq(tag, "program") {
        let p = after_tag(ast, 0)
        let alen = str_len(ast)
        for _pf in 0..5000 {
            p = skip_ws(ast, p)
            if p >= alen - 1 { break }
            if char_code(char_at(ast, p)) == 41 { break }
            let decl = child_at(ast, p)
            if str_len(decl) == 0 { break }
            p = skip_child(ast, p)
            let dtag = node_tag(decl, 0)
            if str_eq(dtag, "fn") {
                let dp = after_tag(decl, 0)
                dp = skip_ws(decl, dp)
                let fname = read_word(decl, dp)
                dp = dp + str_len(fname)
                dp = skip_ws(decl, dp)
                // Skip params
                dp = skip_child(decl, dp)
                dp = skip_ws(decl, dp)
                // Check for ->type
                let dlen = str_len(decl)
                if dp < dlen {
                    let next = read_word(decl, dp)
                    if str_len(next) > 2 {
                        let c0 = char_code(char_at(next, 0))
                        if c0 == 45 {
                            let rtype = str_slice(next, 2, str_len(next))
                            if str_eq(rtype, "string") {
                                str_fns = str_fns + fname + "\n"
                            } else if str_eq(rtype, "String") {
                                str_fns = str_fns + fname + "\n"
                            } else if str_eq(rtype, "LcnString") {
                                str_fns = str_fns + fname + "\n"
                            }
                        }
                    }
                }
            }
        }
    }
    str_fns
}

// Check if function is known to return string
fn fn_returns_string(str_fns: string, fname: string) -> bool {
    let needle = fname + "\n"
    let idx = str_find(str_fns, needle)
    idx >= 0
}

// ── Forward Declarations ────────────────────────────────────
// Pre-scan all top-level functions and emit forward declarations.
// This is needed because C99 requires functions to be declared before use.

fn emit_fn_prototype(node: string) -> string {
    // (fn name (params (pname [:type]) ...) [->rettype] (block ...))
    let p = after_tag(node, 0)
    p = skip_ws(node, p)
    let name = read_word(node, p)
    p = p + str_len(name)
    p = skip_ws(node, p)

    // Parse params
    let params_node = child_at(node, p)
    p = skip_child(node, p)
    p = skip_ws(node, p)

    // Check for return type: ->type
    let ret_type = "void"
    let nlen = str_len(node)
    if p < nlen {
        let next = read_word(node, p)
        if str_len(next) > 0 {
            let c0 = char_code(char_at(next, 0))
            if c0 == 45 {
                if str_len(next) > 2 {
                    ret_type = map_type(str_slice(next, 2, str_len(next)))
                } else {
                    p = p + str_len(next)
                    p = skip_ws(node, p)
                    let rty = read_word(node, p)
                    ret_type = map_type(rty)
                }
            }
        }
    }

    let out = sb_new()
    sb_append(out, "static ")
    sb_append(out, ret_type)
    sb_append(out, " lcn_")
    sb_append(out, name)
    sb_append(out, "(")

    // Parse parameter list for prototype
    let param_sb = sb_new()
    let param_count = 0
    let ptag = node_tag(params_node, 0)
    if str_eq(ptag, "params") {
        let pp = after_tag(params_node, 0)
        let plen = str_len(params_node)
        for _fp in 0..50 {
            pp = skip_ws(params_node, pp)
            if pp >= plen - 1 { break }
            if char_code(char_at(params_node, pp)) == 41 { break }
            let param = child_at(params_node, pp)
            pp = skip_child(params_node, pp)
            let prp = 0
            let prlen = str_len(param)
            if prlen > 0 {
                if char_code(char_at(param, 0)) == 40 {
                    prp = 1
                }
            }
            prp = skip_ws(param, prp)
            let pname = read_word(param, prp)
            prp = prp + str_len(pname)
            prp = skip_ws(param, prp)
            let pty = "int64_t"
            if prp < prlen {
                if char_code(char_at(param, prp)) == 58 {
                    prp = prp + 1
                    let ptname = read_word(param, prp)
                    pty = map_type(ptname)
                }
            }
            if param_count > 0 {
                sb_append(param_sb, ", ")
            }
            sb_append(param_sb, pty)
            sb_append(param_sb, " ")
            sb_append(param_sb, pname)
            param_count = param_count + 1
        }
    }
    if param_count == 0 {
        sb_append(out, "void")
    } else {
        sb_append(out, sb_to_string(param_sb))
    }
    sb_append(out, ");\n")
    sb_to_string(out)
}

fn emit_forward_declarations(ast: string) -> string {
    let out = sb_new()
    let tag = node_tag(ast, 0)
    if str_eq(tag, "program") {
        sb_append(out, "/* Forward declarations */\n")
        let p = after_tag(ast, 0)
        let alen = str_len(ast)
        for _fwd in 0..5000 {
            p = skip_ws(ast, p)
            if p >= alen - 1 { break }
            if char_code(char_at(ast, p)) == 41 { break }
            let decl = child_at(ast, p)
            if str_len(decl) == 0 { break }
            p = skip_child(ast, p)
            let dtag = node_tag(decl, 0)
            if str_eq(dtag, "fn") {
                sb_append(out, emit_fn_prototype(decl))
            }
        }
        sb_append(out, "\n")
    }
    sb_to_string(out)
}

fn emit_program(ast: string) -> string {
    let out = sb_new()

    // Detect if runtime is needed
    let use_runtime = needs_runtime(ast)

    // Preamble
    sb_append(out, emit_preamble(use_runtime))

    // Pre-scan: collect function return types for type inference
    let str_fns = prescan_fn_ret_types(ast)

    // Pre-scan: collect agent names and methods for method call rewriting
    let agent_names = ""
    let agent_methods = ""
    let tag = node_tag(ast, 0)
    if str_eq(tag, "program") {
        let sp = after_tag(ast, 0)
        let salen = str_len(ast)
        for _scan in 0..5000 {
            sp = skip_ws(ast, sp)
            if sp >= salen - 1 { break }
            if char_code(char_at(ast, sp)) == 41 { break }
            let sdecl = child_at(ast, sp)
            if str_len(sdecl) == 0 { break }
            sp = skip_child(ast, sp)
            let sdtag = node_tag(sdecl, 0)
            if str_eq(sdtag, "agent") {
                let sap = after_tag(sdecl, 0)
                sap = skip_ws(sdecl, sap)
                let saname = read_word(sdecl, sap)
                agent_names = agent_names + saname + "\n"
                sap = sap + str_len(saname)
                // Scan for method (fn) children
                let sdlen = str_len(sdecl)
                for _sm in 0..200 {
                    sap = skip_ws(sdecl, sap)
                    if sap >= sdlen - 1 { break }
                    if char_code(char_at(sdecl, sap)) == 41 { break }
                    let schild = child_at(sdecl, sap)
                    sap = skip_child(sdecl, sap)
                    let sctag = node_tag(schild, 0)
                    if str_eq(sctag, "fn") {
                        let smp = after_tag(schild, 0)
                        smp = skip_ws(schild, smp)
                        let smname = read_word(schild, smp)
                        agent_methods = agent_methods + saname + "." + smname + "\n"
                    }
                }
            }
        }
    }

    // Walk top-level declarations
    // Seed svars with function return type info: "fn:name\n" for string-returning functions
    let svars = ""
    // Parse str_fns and add as fn: entries
    let sfp = 0
    let sf_len = str_len(str_fns)
    for _sf in 0..1000 {
        if sfp >= sf_len { break }
        let nl = str_find(str_slice(str_fns, sfp, sf_len), "\n")
        if nl < 0 { break }
        let fn_name_raw = str_slice(str_fns, sfp, sfp + nl)
        if str_len(fn_name_raw) > 0 {
            svars = svars + "fn:" + fn_name_raw + "\n"
        }
        sfp = sfp + nl + 1
    }
    let has_main = false
    let main_ret_type = "void"
    let closure_counter = 0

    if str_eq(tag, "program") {
        // ── Pass 1: Emit type definitions (struct, enum) ──
        let p1 = after_tag(ast, 0)
        let alen = str_len(ast)
        for _pass1 in 0..5000 {
            p1 = skip_ws(ast, p1)
            if p1 >= alen - 1 { break }
            if char_code(char_at(ast, p1)) == 41 { break }
            let decl1 = child_at(ast, p1)
            if str_len(decl1) == 0 { break }
            p1 = skip_child(ast, p1)
            let dtag1 = node_tag(decl1, 0)
            if str_eq(dtag1, "struct") {
                // (struct Name (field :type) ...)
                let sp2 = after_tag(decl1, 0)
                sp2 = skip_ws(decl1, sp2)
                let sname = read_word(decl1, sp2)
                sp2 = sp2 + str_len(sname)
                sb_append(out, "typedef struct {\n")
                let dlen = str_len(decl1)
                for _sf in 0..100 {
                    sp2 = skip_ws(decl1, sp2)
                    if sp2 >= dlen - 1 { break }
                    if char_code(char_at(decl1, sp2)) == 41 { break }
                    let field = child_at(decl1, sp2)
                    sp2 = skip_child(decl1, sp2)
                    let ffp = 0
                    if str_len(field) > 0 {
                        if char_code(char_at(field, 0)) == 40 {
                            ffp = 1
                        }
                    }
                    ffp = skip_ws(field, ffp)
                    let ff_name = read_word(field, ffp)
                    ffp = ffp + str_len(ff_name)
                    ffp = skip_ws(field, ffp)
                    let ff_type = "int64_t"
                    if ffp < str_len(field) {
                        if char_code(char_at(field, ffp)) == 58 {
                            ffp = ffp + 1
                            let fty = read_word(field, ffp)
                            ff_type = map_type(fty)
                        }
                    }
                    sb_append(out, "    ")
                    sb_append(out, ff_type)
                    sb_append(out, " ")
                    sb_append(out, ff_name)
                    sb_append(out, ";\n")
                }
                sb_append(out, "} ")
                sb_append(out, sname)
                sb_append(out, ";\n\n")
            } else if str_eq(dtag1, "enum") {
                let ep = after_tag(decl1, 0)
                ep = skip_ws(decl1, ep)
                let ename = read_word(decl1, ep)
                ep = ep + str_len(ename)
                sb_append(out, "/* enum ")
                sb_append(out, ename)
                sb_append(out, " */\n")
                let vidx = 0
                let elen = str_len(decl1)
                for _ev in 0..100 {
                    ep = skip_ws(decl1, ep)
                    if ep >= elen - 1 { break }
                    if char_code(char_at(decl1, ep)) == 41 { break }
                    let vname = read_word(decl1, ep)
                    ep = ep + str_len(vname)
                    sb_append(out, "#define ")
                    sb_append(out, ename)
                    sb_append(out, "_")
                    sb_append(out, vname)
                    sb_append(out, " \"")
                    sb_append(out, vname)
                    sb_append(out, "\"\n")
                    vidx = vidx + 1
                }
                sb_append(out, "\n")
            } else if str_eq(dtag1, "interface") {
                // (interface Name (fn method (params ...) ->rettype) ...)
                // Emit vtable struct + trait object
                let ip = after_tag(decl1, 0)
                ip = skip_ws(decl1, ip)
                let iname = read_word(decl1, ip)
                ip = ip + str_len(iname)
                sb_append(out, "/* interface ")
                sb_append(out, iname)
                sb_append(out, " — vtable */\n")
                // 1. vtable struct
                sb_append(out, "typedef struct {\n")
                let idlen = str_len(decl1)
                for _im in 0..100 {
                    ip = skip_ws(decl1, ip)
                    if ip >= idlen - 1 { break }
                    if char_code(char_at(decl1, ip)) == 41 { break }
                    let ichild = child_at(decl1, ip)
                    ip = skip_child(decl1, ip)
                    let ictag = node_tag(ichild, 0)
                    if str_eq(ictag, "fn") {
                        let mp = after_tag(ichild, 0)
                        mp = skip_ws(ichild, mp)
                        let mname = read_word(ichild, mp)
                        mp = mp + str_len(mname)
                        mp = skip_ws(ichild, mp)
                        // Skip params node
                        let mparams = child_at(ichild, mp)
                        mp = skip_child(ichild, mp)
                        mp = skip_ws(ichild, mp)
                        // Check for return type
                        let mret = "void"
                        let mlen = str_len(ichild)
                        if mp < mlen {
                            let mnext = read_word(ichild, mp)
                            if str_len(mnext) > 2 {
                                let mc0 = char_code(char_at(mnext, 0))
                                if mc0 == 45 {
                                    mret = map_type(str_slice(mnext, 2, str_len(mnext)))
                                }
                            }
                        }
                        sb_append(out, "    ")
                        sb_append(out, mret)
                        sb_append(out, " (*")
                        sb_append(out, mname)
                        sb_append(out, ")(void *self")
                        // Emit params (skip 'self')
                        let mptag = node_tag(mparams, 0)
                        if str_eq(mptag, "params") {
                            let mpp = after_tag(mparams, 0)
                            let mplen = str_len(mparams)
                            for _mp in 0..50 {
                                mpp = skip_ws(mparams, mpp)
                                if mpp >= mplen - 1 { break }
                                if char_code(char_at(mparams, mpp)) == 41 { break }
                                let mparam = child_at(mparams, mpp)
                                mpp = skip_child(mparams, mpp)
                                let mprp = 0
                                let mprlen = str_len(mparam)
                                if mprlen > 0 {
                                    if char_code(char_at(mparam, 0)) == 40 {
                                        mprp = 1
                                    }
                                }
                                mprp = skip_ws(mparam, mprp)
                                let mpname = read_word(mparam, mprp)
                                if str_eq(mpname, "self") {
                                    // skip self param
                                    mpname = ""
                                }
                                if str_len(mpname) > 0 {
                                    mprp = mprp + str_len(mpname)
                                    mprp = skip_ws(mparam, mprp)
                                    let mpty = "int64_t"
                                    if mprp < mprlen {
                                        if char_code(char_at(mparam, mprp)) == 58 {
                                            mprp = mprp + 1
                                            let mptname = read_word(mparam, mprp)
                                            mpty = map_type(mptname)
                                        }
                                    }
                                    sb_append(out, ", ")
                                    sb_append(out, mpty)
                                    sb_append(out, " ")
                                    sb_append(out, mpname)
                                }
                            }
                        }
                        sb_append(out, ");\n")
                    }
                }
                sb_append(out, "} ")
                sb_append(out, iname)
                sb_append(out, "_vtable;\n\n")
                // 2. trait object
                sb_append(out, "typedef struct {\n")
                sb_append(out, "    void *data;\n")
                sb_append(out, "    ")
                sb_append(out, iname)
                sb_append(out, "_vtable *vt;\n")
                sb_append(out, "} ")
                sb_append(out, iname)
                sb_append(out, "_obj;\n\n")
            } else if str_eq(dtag1, "type_alias") {
                // (type_alias Name (union type1 type2 ...))
                // Emit tag enum + tagged union struct + constructors
                let tap = after_tag(decl1, 0)
                tap = skip_ws(decl1, tap)
                let taname = read_word(decl1, tap)
                tap = tap + str_len(taname)
                tap = skip_ws(decl1, tap)
                let ta_child = child_at(decl1, tap)
                let ta_ctag = node_tag(ta_child, 0)
                if str_eq(ta_ctag, "union") {
                    sb_append(out, "/* union type ")
                    sb_append(out, taname)
                    sb_append(out, " */\n")
                    // 1. Tag enum
                    sb_append(out, "typedef enum {\n")
                    let uvp = after_tag(ta_child, 0)
                    let uvlen = str_len(ta_child)
                    let uvidx = 0
                    // Collect variant names for later use
                    let uv_names = sb_new()
                    for _uv in 0..50 {
                        uvp = skip_ws(ta_child, uvp)
                        if uvp >= uvlen - 1 { break }
                        if char_code(char_at(ta_child, uvp)) == 41 { break }
                        let uv_node = child_at(ta_child, uvp)
                        uvp = skip_child(ta_child, uvp)
                        // Extract variant type name
                        let uv_tag = node_tag(uv_node, 0)
                        let uvname = ""
                        if str_eq(uv_tag, "type_named") {
                            let uvnp = after_tag(uv_node, 0)
                            uvnp = skip_ws(uv_node, uvnp)
                            uvname = read_word(uv_node, uvnp)
                        } else {
                            uvname = uv_node
                        }
                        if str_len(uvname) > 0 {
                            sb_append(out, "    ")
                            sb_append(out, taname)
                            sb_append(out, "_TAG_")
                            sb_append(out, uvname)
                            sb_append(out, " = ")
                            sb_append(out, to_string(uvidx))
                            sb_append(out, ",\n")
                            sb_append(uv_names, uvname)
                            sb_append(uv_names, "\n")
                            uvidx = uvidx + 1
                        }
                    }
                    sb_append(out, "} ")
                    sb_append(out, taname)
                    sb_append(out, "_Tag;\n\n")
                    // 2. Tagged union struct
                    sb_append(out, "typedef struct {\n")
                    sb_append(out, "    ")
                    sb_append(out, taname)
                    sb_append(out, "_Tag tag;\n")
                    sb_append(out, "    union {\n")
                    // Re-parse variants for fields
                    let uvp2 = after_tag(ta_child, 0)
                    for _uv2 in 0..50 {
                        uvp2 = skip_ws(ta_child, uvp2)
                        if uvp2 >= uvlen - 1 { break }
                        if char_code(char_at(ta_child, uvp2)) == 41 { break }
                        let uv_node2 = child_at(ta_child, uvp2)
                        uvp2 = skip_child(ta_child, uvp2)
                        let uv_tag2 = node_tag(uv_node2, 0)
                        let uvname2 = ""
                        if str_eq(uv_tag2, "type_named") {
                            let uvnp2 = after_tag(uv_node2, 0)
                            uvnp2 = skip_ws(uv_node2, uvnp2)
                            uvname2 = read_word(uv_node2, uvnp2)
                        } else {
                            uvname2 = uv_node2
                        }
                        if str_len(uvname2) > 0 {
                            sb_append(out, "        ")
                            sb_append(out, map_type(uvname2))
                            sb_append(out, " as_")
                            sb_append(out, uvname2)
                            sb_append(out, ";\n")
                        }
                    }
                    sb_append(out, "    };\n")
                    sb_append(out, "} ")
                    sb_append(out, taname)
                    sb_append(out, ";\n\n")
                    // 3. Constructor functions
                    let uvp3 = after_tag(ta_child, 0)
                    for _uv3 in 0..50 {
                        uvp3 = skip_ws(ta_child, uvp3)
                        if uvp3 >= uvlen - 1 { break }
                        if char_code(char_at(ta_child, uvp3)) == 41 { break }
                        let uv_node3 = child_at(ta_child, uvp3)
                        uvp3 = skip_child(ta_child, uvp3)
                        let uv_tag3 = node_tag(uv_node3, 0)
                        let uvname3 = ""
                        if str_eq(uv_tag3, "type_named") {
                            let uvnp3 = after_tag(uv_node3, 0)
                            uvnp3 = skip_ws(uv_node3, uvnp3)
                            uvname3 = read_word(uv_node3, uvnp3)
                        } else {
                            uvname3 = uv_node3
                        }
                        if str_len(uvname3) > 0 {
                            let ctype3 = map_type(uvname3)
                            sb_append(out, "static ")
                            sb_append(out, taname)
                            sb_append(out, " ")
                            sb_append(out, taname)
                            sb_append(out, "_from_")
                            sb_append(out, uvname3)
                            sb_append(out, "(")
                            sb_append(out, ctype3)
                            sb_append(out, " val) {\n")
                            sb_append(out, "    ")
                            sb_append(out, taname)
                            sb_append(out, " _u;\n")
                            sb_append(out, "    _u.tag = ")
                            sb_append(out, taname)
                            sb_append(out, "_TAG_")
                            sb_append(out, uvname3)
                            sb_append(out, ";\n")
                            sb_append(out, "    _u.as_")
                            sb_append(out, uvname3)
                            sb_append(out, " = val;\n")
                            sb_append(out, "    return _u;\n")
                            sb_append(out, "}\n\n")
                            // is_type check
                            sb_append(out, "static bool ")
                            sb_append(out, taname)
                            sb_append(out, "_is_")
                            sb_append(out, uvname3)
                            sb_append(out, "(")
                            sb_append(out, taname)
                            sb_append(out, " val) { return val.tag == ")
                            sb_append(out, taname)
                            sb_append(out, "_TAG_")
                            sb_append(out, uvname3)
                            sb_append(out, "; }\n\n")
                        }
                    }
                } else {
                    sb_append(out, "/* type_alias ")
                    sb_append(out, taname)
                    sb_append(out, " */\n")
                }
            } else if str_eq(dtag1, "link") {
                // (link "flags") -> emit as comment
                let lp = after_tag(decl1, 0)
                lp = skip_ws(decl1, lp)
                let lflags = ""
                let ldlen = str_len(decl1)
                if lp < ldlen {
                    if char_code(char_at(decl1, lp)) == 34 {
                        lflags = read_quoted(decl1, lp)
                    } else {
                        lflags = read_word(decl1, lp)
                    }
                }
                sb_append(out, "/* link: ")
                sb_append(out, lflags)
                sb_append(out, " */\n")
            } else if str_eq(dtag1, "use") {
                sb_append(out, "/* use */\n")
            } else if str_eq(dtag1, "endpoint") {
                sb_append(out, "/* endpoint */\n")
            } else if str_eq(dtag1, "capability") {
                sb_append(out, "/* capability */\n")
            } else if str_eq(dtag1, "budget") {
                sb_append(out, "/* budget */\n")
            } else if str_eq(dtag1, "tool") {
                sb_append(out, "/* tool */\n")
            } else if str_eq(dtag1, "guard") {
                sb_append(out, "/* guard */\n")
            }
        }

        // ── Forward declarations for all functions ──
        sb_append(out, emit_forward_declarations(ast))

        // ── Pass 2: Emit function and agent definitions ──
        let p = after_tag(ast, 0)
        for _decl in 0..5000 {
            p = skip_ws(ast, p)
            if p >= alen - 1 { break }
            if char_code(char_at(ast, p)) == 41 { break }
            let decl = child_at(ast, p)
            if str_len(decl) == 0 { break }
            p = skip_child(ast, p)

            let dtag = node_tag(decl, 0)
            if str_eq(dtag, "fn") {
                // Check if this is main
                let dp = after_tag(decl, 0)
                dp = skip_ws(decl, dp)
                let fname = read_word(decl, dp)
                if str_eq(fname, "main") {
                    has_main = true
                    // Determine return type
                    dp = dp + str_len(fname)
                    dp = skip_ws(decl, dp)
                    // skip params
                    dp = skip_child(decl, dp)
                    dp = skip_ws(decl, dp)
                    let next_w = read_word(decl, dp)
                    if str_len(next_w) > 0 {
                        let c0 = char_code(char_at(next_w, 0))
                        if c0 == 45 {
                            if str_len(next_w) > 2 {
                                main_ret_type = map_type(str_slice(next_w, 2, str_len(next_w)))
                            }
                        }
                    }
                }

                // Scan for closures in this function and emit deferred defs
                let n_closures = count_closures_in(decl)
                if n_closures > 0 {
                    sb_append(out, "/* Closure definitions for ")
                    sb_append(out, fname)
                    sb_append(out, " */\n")
                    let cpos = 0
                    let cdecl_len = str_len(decl)
                    for _cf in 0..100 {
                        if cpos >= cdecl_len { break }
                        let cidx = str_find(str_slice(decl, cpos, cdecl_len), "(closure ")
                        if cidx < 0 { break }
                        let closure_start = cpos + cidx
                        let closure_node = child_at(decl, closure_start)
                        sb_append(out, emit_closure_fn(svars, closure_node, closure_counter))
                        closure_counter = closure_counter + 1
                        cpos = closure_start + 9
                    }
                }

                // Set closure base ID in svars so emit_expr can reference the right closure
                let fn_svars_clo = set_closure_id(svars, closure_counter - n_closures)
                sb_append(out, emit_fn(fn_svars_clo, decl))
            } else if str_eq(dtag, "agent") {
                sb_append(out, emit_agent(svars, decl))

                // Emit agent methods
                let ap = after_tag(decl, 0)
                ap = skip_ws(decl, ap)
                let aname = read_word(decl, ap)
                ap = ap + str_len(aname)
                let adlen = str_len(decl)
                for _am in 0..200 {
                    ap = skip_ws(decl, ap)
                    if ap >= adlen - 1 { break }
                    if char_code(char_at(decl, ap)) == 41 { break }
                    let achild = child_at(decl, ap)
                    ap = skip_child(decl, ap)
                    let actag = node_tag(achild, 0)
                    if str_eq(actag, "fn") {
                        sb_append(out, emit_agent_method(svars, aname, achild, agent_methods))
                    }
                }
            } else if str_eq(dtag, "impl") {
                // (impl TypeName (fn method ...) ...)
                // or (impl TypeName TraitName (fn method ...) ...)
                let ip = after_tag(decl, 0)
                ip = skip_ws(decl, ip)
                let impl_type = read_word(decl, ip)
                ip = ip + str_len(impl_type)
                ip = skip_ws(decl, ip)
                let idlen = str_len(decl)
                // Check if next word is a trait name (not a paren = fn child)
                let impl_trait_name = ""
                if ip < idlen {
                    let ic0 = char_code(char_at(decl, ip))
                    if ic0 != 40 {
                        if ic0 != 41 {
                            impl_trait_name = read_word(decl, ip)
                            ip = ip + str_len(impl_trait_name)
                        }
                    }
                }
                if str_len(impl_trait_name) > 0 {
                    // impl Trait for Type -> vtable wrapper shims + vtable instance
                    sb_append(out, "/* impl ")
                    sb_append(out, impl_trait_name)
                    sb_append(out, " for ")
                    sb_append(out, impl_type)
                    sb_append(out, " */\n")
                    // 1. Emit wrapper shims
                    let vt_methods = sb_new()
                    let itp = ip
                    for _it in 0..200 {
                        itp = skip_ws(decl, itp)
                        if itp >= idlen - 1 { break }
                        if char_code(char_at(decl, itp)) == 41 { break }
                        let itchild = child_at(decl, itp)
                        itp = skip_child(decl, itp)
                        let ittag = node_tag(itchild, 0)
                        if str_eq(ittag, "fn") {
                            let itp2 = after_tag(itchild, 0)
                            itp2 = skip_ws(itchild, itp2)
                            let itmname = read_word(itchild, itp2)
                            itp2 = itp2 + str_len(itmname)
                            itp2 = skip_ws(itchild, itp2)
                            // Parse params
                            let itparams = child_at(itchild, itp2)
                            itp2 = skip_child(itchild, itp2)
                            itp2 = skip_ws(itchild, itp2)
                            // Return type
                            let itmret = "void"
                            let itmlen = str_len(itchild)
                            if itp2 < itmlen {
                                let itmnext = read_word(itchild, itp2)
                                if str_len(itmnext) > 2 {
                                    let itmc0 = char_code(char_at(itmnext, 0))
                                    if itmc0 == 45 {
                                        itmret = map_type(str_slice(itmnext, 2, str_len(itmnext)))
                                    }
                                }
                            }
                            let has_ret = true
                            if str_eq(itmret, "void") {
                                has_ret = false
                            }
                            // Emit shim: static RetType Type_Trait_method(void *self, params...)
                            sb_append(out, "static ")
                            sb_append(out, itmret)
                            sb_append(out, " ")
                            sb_append(out, impl_type)
                            sb_append(out, "_")
                            sb_append(out, impl_trait_name)
                            sb_append(out, "_")
                            sb_append(out, itmname)
                            sb_append(out, "(void *self")
                            // Emit non-self params
                            let itmptag = node_tag(itparams, 0)
                            let itm_pnames = sb_new()
                            if str_eq(itmptag, "params") {
                                let itmpp = after_tag(itparams, 0)
                                let itmplen = str_len(itparams)
                                for _itmp in 0..50 {
                                    itmpp = skip_ws(itparams, itmpp)
                                    if itmpp >= itmplen - 1 { break }
                                    if char_code(char_at(itparams, itmpp)) == 41 { break }
                                    let itmparam = child_at(itparams, itmpp)
                                    itmpp = skip_child(itparams, itmpp)
                                    let itmprp = 0
                                    let itmprlen = str_len(itmparam)
                                    if itmprlen > 0 {
                                        if char_code(char_at(itmparam, 0)) == 40 {
                                            itmprp = 1
                                        }
                                    }
                                    itmprp = skip_ws(itmparam, itmprp)
                                    let itmpname = read_word(itmparam, itmprp)
                                    if str_eq(itmpname, "self") {
                                        itmpname = ""
                                    }
                                    if str_len(itmpname) > 0 {
                                        itmprp = itmprp + str_len(itmpname)
                                        itmprp = skip_ws(itmparam, itmprp)
                                        let itmpty = "int64_t"
                                        if itmprp < itmprlen {
                                            if char_code(char_at(itmparam, itmprp)) == 58 {
                                                itmprp = itmprp + 1
                                                let itmptname = read_word(itmparam, itmprp)
                                                itmpty = map_type(itmptname)
                                            }
                                        }
                                        sb_append(out, ", ")
                                        sb_append(out, itmpty)
                                        sb_append(out, " ")
                                        sb_append(out, itmpname)
                                        sb_append(itm_pnames, ", ")
                                        sb_append(itm_pnames, itmpname)
                                    }
                                }
                            }
                            sb_append(out, ") {\n")
                            sb_append(out, "    ")
                            if has_ret {
                                sb_append(out, "return ")
                            }
                            sb_append(out, impl_type)
                            sb_append(out, "_")
                            sb_append(out, itmname)
                            sb_append(out, "((")
                            sb_append(out, impl_type)
                            sb_append(out, " *)self")
                            sb_append(out, sb_to_string(itm_pnames))
                            sb_append(out, ");\n")
                            sb_append(out, "}\n\n")
                            // Track method for vtable
                            sb_append(vt_methods, itmname)
                            sb_append(vt_methods, "\n")
                            // Also emit the actual method as a normal function
                            sb_append(out, emit_fn(svars, itchild))
                        }
                    }
                    // 2. Emit static vtable instance
                    sb_append(out, "static ")
                    sb_append(out, impl_trait_name)
                    sb_append(out, "_vtable ")
                    sb_append(out, impl_type)
                    sb_append(out, "_")
                    sb_append(out, impl_trait_name)
                    sb_append(out, "_vt = {\n")
                    // Parse vt_methods names
                    let vt_str = sb_to_string(vt_methods)
                    let vtp = 0
                    let vtlen = str_len(vt_str)
                    for _vt in 0..100 {
                        if vtp >= vtlen { break }
                        let vtnl = str_find(str_slice(vt_str, vtp, vtlen), "\n")
                        if vtnl < 0 { break }
                        let vtmname = str_slice(vt_str, vtp, vtp + vtnl)
                        if str_len(vtmname) > 0 {
                            sb_append(out, "    .")
                            sb_append(out, vtmname)
                            sb_append(out, " = ")
                            sb_append(out, impl_type)
                            sb_append(out, "_")
                            sb_append(out, impl_trait_name)
                            sb_append(out, "_")
                            sb_append(out, vtmname)
                            sb_append(out, ",\n")
                        }
                        vtp = vtp + vtnl + 1
                    }
                    sb_append(out, "};\n\n")
                } else {
                    // Plain impl — emit methods
                    for _im in 0..200 {
                        ip = skip_ws(decl, ip)
                        if ip >= idlen - 1 { break }
                        if char_code(char_at(decl, ip)) == 41 { break }
                        let ichild = child_at(decl, ip)
                        ip = skip_child(decl, ip)
                        let ictag = node_tag(ichild, 0)
                        if str_eq(ictag, "fn") {
                            sb_append(out, "/* impl ")
                            sb_append(out, impl_type)
                            sb_append(out, " */\n")
                            sb_append(out, emit_fn(svars, ichild))
                        }
                    }
                }
            } else if str_eq(dtag, "supervisor") {
                // (supervisor Name (field strategy value) (field children [...]) ...)
                let sup_p = after_tag(decl, 0)
                sup_p = skip_ws(decl, sup_p)
                let sup_name = read_word(decl, sup_p)
                sup_p = sup_p + str_len(sup_name)
                let sup_strat = "LCN_STRATEGY_ONE_FOR_ONE"
                let sup_max = "3"
                let sup_window = "60"
                // Collect children names
                let sup_children = sb_new()
                let sup_child_count = 0
                let sup_dlen = str_len(decl)
                for _sf in 0..200 {
                    sup_p = skip_ws(decl, sup_p)
                    if sup_p >= sup_dlen - 1 { break }
                    if char_code(char_at(decl, sup_p)) == 41 { break }
                    let sf_child = child_at(decl, sup_p)
                    sup_p = skip_child(decl, sup_p)
                    let sfc_tag = node_tag(sf_child, 0)
                    if str_eq(sfc_tag, "field") {
                        let sfp = after_tag(sf_child, 0)
                        sfp = skip_ws(sf_child, sfp)
                        let sf_fname = read_word(sf_child, sfp)
                        sfp = sfp + str_len(sf_fname)
                        sfp = skip_ws(sf_child, sfp)
                        if str_eq(sf_fname, "strategy") {
                            let sf_val = child_at(sf_child, sfp)
                            let sf_vtag = node_tag(sf_val, 0)
                            let sf_strat_name = ""
                            if str_eq(sf_vtag, "ident") {
                                let svp = after_tag(sf_val, 0)
                                svp = skip_ws(sf_val, svp)
                                sf_strat_name = read_word(sf_val, svp)
                            } else {
                                sf_strat_name = sf_val
                            }
                            if str_eq(sf_strat_name, "rest_for_all") {
                                sup_strat = "LCN_STRATEGY_REST_FOR_ALL"
                            } else if str_eq(sf_strat_name, "one_for_all") {
                                sup_strat = "LCN_STRATEGY_ONE_FOR_ALL"
                            }
                        } else if str_eq(sf_fname, "max_restarts") {
                            let sf_val2 = child_at(sf_child, sfp)
                            let sf_v2tag = node_tag(sf_val2, 0)
                            if str_eq(sf_v2tag, "int") {
                                let sfv2p = after_tag(sf_val2, 0)
                                sfv2p = skip_ws(sf_val2, sfv2p)
                                sup_max = read_word(sf_val2, sfv2p)
                            }
                        } else if str_eq(sf_fname, "window") {
                            let sf_val3 = child_at(sf_child, sfp)
                            let sf_v3tag = node_tag(sf_val3, 0)
                            if str_eq(sf_v3tag, "int") {
                                let sfv3p = after_tag(sf_val3, 0)
                                sfv3p = skip_ws(sf_val3, sfv3p)
                                sup_window = read_word(sf_val3, sfv3p)
                            }
                        } else if str_eq(sf_fname, "children") {
                            // (array ident1 ident2 ...)
                            let arr_node = child_at(sf_child, sfp)
                            let arr_tag = node_tag(arr_node, 0)
                            if str_eq(arr_tag, "array") {
                                let arrp = after_tag(arr_node, 0)
                                let arrlen = str_len(arr_node)
                                for _ac in 0..64 {
                                    arrp = skip_ws(arr_node, arrp)
                                    if arrp >= arrlen - 1 { break }
                                    if char_code(char_at(arr_node, arrp)) == 41 { break }
                                    let arr_elem = child_at(arr_node, arrp)
                                    arrp = skip_child(arr_node, arrp)
                                    let ae_tag = node_tag(arr_elem, 0)
                                    let ae_name = ""
                                    if str_eq(ae_tag, "ident") {
                                        let aep = after_tag(arr_elem, 0)
                                        aep = skip_ws(arr_elem, aep)
                                        ae_name = read_word(arr_elem, aep)
                                    } else {
                                        ae_name = arr_elem
                                    }
                                    if str_len(ae_name) > 0 {
                                        sb_append(sup_children, ae_name)
                                        sb_append(sup_children, "\n")
                                        sup_child_count = sup_child_count + 1
                                    }
                                }
                            }
                        }
                    }
                }
                // Emit start/stop stubs for each child
                let sc_str = sb_to_string(sup_children)
                let scp = 0
                let sclen = str_len(sc_str)
                for _sc in 0..64 {
                    if scp >= sclen { break }
                    let scnl = str_find(str_slice(sc_str, scp, sclen), "\n")
                    if scnl < 0 { break }
                    let sc_name = str_slice(sc_str, scp, scp + scnl)
                    if str_len(sc_name) > 0 {
                        sb_append(out, "static void lcn_agent_")
                        sb_append(out, sc_name)
                        sb_append(out, "_start(void) { /* agent start stub */ }\n")
                        sb_append(out, "static void lcn_agent_")
                        sb_append(out, sc_name)
                        sb_append(out, "_stop(void)  { /* agent stop stub */ }\n")
                    }
                    scp = scp + scnl + 1
                }
                sb_append(out, "\n")
                // Emit supervisor global pointer
                sb_append(out, "static LcnSupervisor *_lcn_sup_")
                sb_append(out, sup_name)
                sb_append(out, " = NULL;\n\n")
                // Emit init function
                sb_append(out, "static LcnSupervisor *lcn_supervisor_")
                sb_append(out, sup_name)
                sb_append(out, "_init(void) {\n")
                sb_append(out, "    LcnSupervisor *sup = lcn_supervisor_new(\"")
                sb_append(out, sup_name)
                sb_append(out, "\", ")
                sb_append(out, sup_strat)
                sb_append(out, ", ")
                sb_append(out, sup_max)
                sb_append(out, ", ")
                sb_append(out, sup_window)
                sb_append(out, ");\n")
                // Add children
                let scp2 = 0
                for _sc2 in 0..64 {
                    if scp2 >= sclen { break }
                    let scnl2 = str_find(str_slice(sc_str, scp2, sclen), "\n")
                    if scnl2 < 0 { break }
                    let sc_name2 = str_slice(sc_str, scp2, scp2 + scnl2)
                    if str_len(sc_name2) > 0 {
                        sb_append(out, "    lcn_supervisor_add_child(sup, \"")
                        sb_append(out, sc_name2)
                        sb_append(out, "\", lcn_agent_")
                        sb_append(out, sc_name2)
                        sb_append(out, "_start, lcn_agent_")
                        sb_append(out, sc_name2)
                        sb_append(out, "_stop, LCN_RESTART_ALWAYS);\n")
                    }
                    scp2 = scp2 + scnl2 + 1
                }
                sb_append(out, "    _lcn_sup_")
                sb_append(out, sup_name)
                sb_append(out, " = sup;\n")
                sb_append(out, "    return sup;\n")
                sb_append(out, "}\n\n")
                // Emit report_failure helper
                sb_append(out, "static int lcn_supervisor_")
                sb_append(out, sup_name)
                sb_append(out, "_report_failure(const char *agent_name) {\n")
                sb_append(out, "    if (!_lcn_sup_")
                sb_append(out, sup_name)
                sb_append(out, ") return -1;\n")
                sb_append(out, "    for (int i = 0; i < _lcn_sup_")
                sb_append(out, sup_name)
                sb_append(out, "->child_count; i++) {\n")
                sb_append(out, "        if (strcmp(_lcn_sup_")
                sb_append(out, sup_name)
                sb_append(out, "->children[i].name, agent_name) == 0)\n")
                sb_append(out, "            return lcn_supervisor_child_failed(_lcn_sup_")
                sb_append(out, sup_name)
                sb_append(out, ", i);\n")
                sb_append(out, "    }\n")
                sb_append(out, "    return -1;\n")
                sb_append(out, "}\n\n")
            } else if str_eq(dtag, "mesh") {
                // (mesh Name (stage "label" AgentName) ...) — sequential pipeline
                // or (mesh Name (route from to) ...) — parallel with routes
                let mesh_p = after_tag(decl, 0)
                mesh_p = skip_ws(decl, mesh_p)
                let mesh_name = read_word(decl, mesh_p)
                mesh_p = mesh_p + str_len(mesh_name)
                sb_append(out, "/* mesh ")
                sb_append(out, mesh_name)
                sb_append(out, " */\n")
                // Check if it has routes
                let has_routes = false
                if str_find(decl, "(route ") >= 0 {
                    has_routes = true
                }
                let mrdlen = str_len(decl)
                if has_routes {
                    // Collect unique agent names from routes
                    let m_agents = sb_new()
                    let mrp = mesh_p
                    for _mr in 0..200 {
                        mrp = skip_ws(decl, mrp)
                        if mrp >= mrdlen - 1 { break }
                        if char_code(char_at(decl, mrp)) == 41 { break }
                        let mr_child = child_at(decl, mrp)
                        mrp = skip_child(decl, mrp)
                        let mr_tag = node_tag(mr_child, 0)
                        if str_eq(mr_tag, "route") {
                            // Collect agent names from this route
                            let mrcp = after_tag(mr_child, 0)
                            let mrclen = str_len(mr_child)
                            for _mrc in 0..20 {
                                mrcp = skip_ws(mr_child, mrcp)
                                if mrcp >= mrclen - 1 { break }
                                if char_code(char_at(mr_child, mrcp)) == 41 { break }
                                let mr_elem = child_at(mr_child, mrcp)
                                mrcp = skip_child(mr_child, mrcp)
                                let mre_tag = node_tag(mr_elem, 0)
                                let mr_aname = ""
                                if str_eq(mre_tag, "ident") {
                                    let mrep = after_tag(mr_elem, 0)
                                    mrep = skip_ws(mr_elem, mrep)
                                    mr_aname = read_word(mr_elem, mrep)
                                } else {
                                    mr_aname = mr_elem
                                }
                                if str_len(mr_aname) > 0 {
                                    if str_eq(mr_aname, "input") == false {
                                        if str_eq(mr_aname, "output") == false {
                                            // Add if not already present
                                            let needle = mr_aname + "\n"
                                            if str_find(sb_to_string(m_agents), needle) < 0 {
                                                sb_append(m_agents, mr_aname)
                                                sb_append(m_agents, "\n")
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // Emit agent wrapper shims
                    let ma_str = sb_to_string(m_agents)
                    let map2 = 0
                    let malen = str_len(ma_str)
                    for _maw in 0..128 {
                        if map2 >= malen { break }
                        let manl = str_find(str_slice(ma_str, map2, malen), "\n")
                        if manl < 0 { break }
                        let ma_name = str_slice(ma_str, map2, map2 + manl)
                        if str_len(ma_name) > 0 {
                            sb_append(out, "static LcnString lcn_mesh_")
                            sb_append(out, mesh_name)
                            sb_append(out, "_agent_")
                            sb_append(out, ma_name)
                            sb_append(out, "(LcnString _input) {\n")
                            sb_append(out, "    Agent_")
                            sb_append(out, ma_name)
                            sb_append(out, " _agent = lcn_agent_")
                            sb_append(out, ma_name)
                            sb_append(out, "_new();\n")
                            sb_append(out, "    LcnLlmOutput _out = lcn_ask_typed(NULL, _agent.model, _agent.prompt, _input, &_agent.budget, NULL, _agent.api_key);\n")
                            sb_append(out, "    if (_out.kind == LCN_LLM_OUTPUT_ERROR) {\n")
                            sb_append(out, "        fprintf(stderr, \"[mesh:")
                            sb_append(out, mesh_name)
                            sb_append(out, "] agent '")
                            sb_append(out, ma_name)
                            sb_append(out, "' failed: %s\\n\", _out.error ? _out.error : \"unknown\");\n")
                            sb_append(out, "        return \"\";\n")
                            sb_append(out, "    }\n")
                            sb_append(out, "    return lcn_llm_output_unwrap(_out);\n")
                            sb_append(out, "}\n\n")
                        }
                        map2 = map2 + manl + 1
                    }
                    // Emit mesh run function with route registration
                    sb_append(out, "static LcnResult lcn_mesh_")
                    sb_append(out, mesh_name)
                    sb_append(out, "_run(LcnString input) {\n")
                    sb_append(out, "    LcnMesh *_mesh = lcn_mesh_new(\"")
                    sb_append(out, mesh_name)
                    sb_append(out, "\");\n\n")
                    // Emit route registrations (simplified: single routes)
                    let mrp2 = mesh_p
                    for _mr2 in 0..200 {
                        mrp2 = skip_ws(decl, mrp2)
                        if mrp2 >= mrdlen - 1 { break }
                        if char_code(char_at(decl, mrp2)) == 41 { break }
                        let mr2_child = child_at(decl, mrp2)
                        mrp2 = skip_child(decl, mrp2)
                        let mr2_tag = node_tag(mr2_child, 0)
                        if str_eq(mr2_tag, "route") {
                            let mr2p = after_tag(mr2_child, 0)
                            mr2p = skip_ws(mr2_child, mr2p)
                            let mr2_src = child_at(mr2_child, mr2p)
                            mr2p = skip_child(mr2_child, mr2p)
                            mr2p = skip_ws(mr2_child, mr2p)
                            let mr2_tgt = child_at(mr2_child, mr2p)
                            let mr2s_tag = node_tag(mr2_src, 0)
                            let mr2t_tag = node_tag(mr2_tgt, 0)
                            let src_n = ""
                            let tgt_n = ""
                            if str_eq(mr2s_tag, "ident") {
                                let mr2sp = after_tag(mr2_src, 0)
                                mr2sp = skip_ws(mr2_src, mr2sp)
                                src_n = read_word(mr2_src, mr2sp)
                            } else {
                                src_n = mr2_src
                            }
                            if str_eq(mr2t_tag, "ident") {
                                let mr2tp = after_tag(mr2_tgt, 0)
                                mr2tp = skip_ws(mr2_tgt, mr2tp)
                                tgt_n = read_word(mr2_tgt, mr2tp)
                            } else if str_eq(mr2t_tag, "array") {
                                // Fan-out: emit fan_out route
                                sb_append(out, "    /* route ")
                                sb_append(out, src_n)
                                sb_append(out, " -> [fan-out] */\n")
                                sb_append(out, "    {\n")
                                // Collect targets
                                let fo_names = sb_new()
                                let fo_fns = sb_new()
                                let fo_count = 0
                                let fop = after_tag(mr2_tgt, 0)
                                let folen = str_len(mr2_tgt)
                                for _fo in 0..20 {
                                    fop = skip_ws(mr2_tgt, fop)
                                    if fop >= folen - 1 { break }
                                    if char_code(char_at(mr2_tgt, fop)) == 41 { break }
                                    let fo_elem = child_at(mr2_tgt, fop)
                                    fop = skip_child(mr2_tgt, fop)
                                    let foe_tag = node_tag(fo_elem, 0)
                                    let fo_name = ""
                                    if str_eq(foe_tag, "ident") {
                                        let foep = after_tag(fo_elem, 0)
                                        foep = skip_ws(fo_elem, foep)
                                        fo_name = read_word(fo_elem, foep)
                                    } else {
                                        fo_name = fo_elem
                                    }
                                    if str_len(fo_name) > 0 {
                                        if fo_count > 0 {
                                            sb_append(fo_names, ", ")
                                            sb_append(fo_fns, ", ")
                                        }
                                        sb_append(fo_names, "\"")
                                        sb_append(fo_names, fo_name)
                                        sb_append(fo_names, "\"")
                                        if str_eq(fo_name, "input") {
                                            sb_append(fo_fns, "NULL")
                                        } else if str_eq(fo_name, "output") {
                                            sb_append(fo_fns, "NULL")
                                        } else {
                                            sb_append(fo_fns, "lcn_mesh_")
                                            sb_append(fo_fns, mesh_name)
                                            sb_append(fo_fns, "_agent_")
                                            sb_append(fo_fns, fo_name)
                                        }
                                        fo_count = fo_count + 1
                                    }
                                }
                                sb_append(out, "        const char *_fo_names[] = {")
                                sb_append(out, sb_to_string(fo_names))
                                sb_append(out, "};\n")
                                sb_append(out, "        LcnMeshAgentFn _fo_fns[] = {")
                                sb_append(out, sb_to_string(fo_fns))
                                sb_append(out, "};\n")
                                sb_append(out, "        lcn_mesh_add_route_fan_out(_mesh, \"")
                                sb_append(out, src_n)
                                sb_append(out, "\", ")
                                if str_eq(src_n, "input") {
                                    sb_append(out, "NULL")
                                } else if str_eq(src_n, "output") {
                                    sb_append(out, "NULL")
                                } else {
                                    sb_append(out, "lcn_mesh_")
                                    sb_append(out, mesh_name)
                                    sb_append(out, "_agent_")
                                    sb_append(out, src_n)
                                }
                                sb_append(out, ", _fo_names, _fo_fns, ")
                                sb_append(out, to_string(fo_count))
                                sb_append(out, ");\n")
                                sb_append(out, "    }\n")
                                tgt_n = ""
                            } else {
                                tgt_n = mr2_tgt
                            }
                            if str_len(tgt_n) > 0 {
                                // Single route: src -> tgt
                                sb_append(out, "    /* route ")
                                sb_append(out, src_n)
                                sb_append(out, " -> ")
                                sb_append(out, tgt_n)
                                sb_append(out, " */\n")
                                sb_append(out, "    lcn_mesh_add_route_single(_mesh, \"")
                                sb_append(out, src_n)
                                sb_append(out, "\", ")
                                if str_eq(src_n, "input") {
                                    sb_append(out, "NULL")
                                } else if str_eq(src_n, "output") {
                                    sb_append(out, "NULL")
                                } else {
                                    sb_append(out, "lcn_mesh_")
                                    sb_append(out, mesh_name)
                                    sb_append(out, "_agent_")
                                    sb_append(out, src_n)
                                }
                                sb_append(out, ", \"")
                                sb_append(out, tgt_n)
                                sb_append(out, "\", ")
                                if str_eq(tgt_n, "input") {
                                    sb_append(out, "NULL")
                                } else if str_eq(tgt_n, "output") {
                                    sb_append(out, "NULL")
                                } else {
                                    sb_append(out, "lcn_mesh_")
                                    sb_append(out, mesh_name)
                                    sb_append(out, "_agent_")
                                    sb_append(out, tgt_n)
                                }
                                sb_append(out, ");\n")
                            }
                        }
                    }
                    sb_append(out, "\n    LcnString _mesh_output = NULL;\n")
                    sb_append(out, "    LcnResult _mesh_result = lcn_mesh_execute(_mesh, input, &_mesh_output);\n")
                    sb_append(out, "    lcn_mesh_free(_mesh);\n")
                    sb_append(out, "    return _mesh_result;\n")
                    sb_append(out, "}\n\n")
                } else {
                    // Sequential pipeline: (mesh Name (stage "label" Agent) ...)
                    sb_append(out, "static LcnResult lcn_mesh_")
                    sb_append(out, mesh_name)
                    sb_append(out, "_run(LcnString input) {\n")
                    sb_append(out, "    LcnString _stage_input = input;\n")
                    sb_append(out, "    LcnLlmOutput _stage_out;\n\n")
                    let msp = mesh_p
                    for _ms in 0..200 {
                        msp = skip_ws(decl, msp)
                        if msp >= mrdlen - 1 { break }
                        if char_code(char_at(decl, msp)) == 41 { break }
                        let ms_child = child_at(decl, msp)
                        msp = skip_child(decl, msp)
                        let ms_tag = node_tag(ms_child, 0)
                        if str_eq(ms_tag, "stage") {
                            let msp2 = after_tag(ms_child, 0)
                            msp2 = skip_ws(ms_child, msp2)
                            // Label (string)
                            let ms_label = ""
                            if char_code(char_at(ms_child, msp2)) == 34 {
                                ms_label = read_quoted(ms_child, msp2)
                                msp2 = skip_quoted(ms_child, msp2)
                            } else {
                                ms_label = read_word(ms_child, msp2)
                                msp2 = msp2 + str_len(ms_label)
                            }
                            msp2 = skip_ws(ms_child, msp2)
                            // Agent name
                            let ms_agent = child_at(ms_child, msp2)
                            let msa_tag = node_tag(ms_agent, 0)
                            let ms_aname = ""
                            if str_eq(msa_tag, "ident") {
                                let msap = after_tag(ms_agent, 0)
                                msap = skip_ws(ms_agent, msap)
                                ms_aname = read_word(ms_agent, msap)
                            } else {
                                ms_aname = ms_agent
                            }
                            sb_append(out, "    /* stage \"")
                            sb_append(out, ms_label)
                            sb_append(out, "\" -> ")
                            sb_append(out, ms_aname)
                            sb_append(out, " */\n")
                            sb_append(out, "    {\n")
                            sb_append(out, "        Agent_")
                            sb_append(out, ms_aname)
                            sb_append(out, " _agent = lcn_agent_")
                            sb_append(out, ms_aname)
                            sb_append(out, "_new();\n")
                            sb_append(out, "        _stage_out = lcn_ask_typed(NULL, _agent.model, _agent.prompt, _stage_input, &_agent.budget, NULL, _agent.api_key);\n")
                            sb_append(out, "        if (_stage_out.kind == LCN_LLM_OUTPUT_ERROR) {\n")
                            sb_append(out, "            fprintf(stderr, \"mesh stage '")
                            sb_append(out, ms_label)
                            sb_append(out, "' failed: %s\\n\", _stage_out.error ? _stage_out.error : \"unknown\");\n")
                            sb_append(out, "            return LCN_ERR(_stage_out.error ? _stage_out.error : \"mesh stage failed\");\n")
                            sb_append(out, "        }\n")
                            sb_append(out, "        _stage_input = lcn_llm_output_unwrap(_stage_out);\n")
                            sb_append(out, "    }\n\n")
                        }
                    }
                    sb_append(out, "    return LCN_OK;\n")
                    sb_append(out, "}\n\n")
                }
            } else if str_eq(dtag, "router") {
                // (router Name (field strategy val) (field fallback val) (rule tier model) ...)
                let rtr_p = after_tag(decl, 0)
                rtr_p = skip_ws(decl, rtr_p)
                let rtr_name = read_word(decl, rtr_p)
                rtr_p = rtr_p + str_len(rtr_name)
                let rtr_strat = ""
                let rtr_fallback = ""
                sb_append(out, "/* router ")
                sb_append(out, rtr_name)
                sb_append(out, " */\n")
                // Emit legacy struct
                sb_append(out, "typedef struct {\n")
                sb_append(out, "    LcnString strategy;\n")
                sb_append(out, "    LcnString fallback;\n")
                sb_append(out, "} Router_")
                sb_append(out, rtr_name)
                sb_append(out, ";\n\n")
                // Pre-scan fields
                let rtr_dlen = str_len(decl)
                let rtr_rules = sb_new()
                let rtr_sp = rtr_p
                for _rf in 0..200 {
                    rtr_sp = skip_ws(decl, rtr_sp)
                    if rtr_sp >= rtr_dlen - 1 { break }
                    if char_code(char_at(decl, rtr_sp)) == 41 { break }
                    let rf_child = child_at(decl, rtr_sp)
                    rtr_sp = skip_child(decl, rtr_sp)
                    let rf_tag = node_tag(rf_child, 0)
                    if str_eq(rf_tag, "field") {
                        let rfp = after_tag(rf_child, 0)
                        rfp = skip_ws(rf_child, rfp)
                        let rf_fname = read_word(rf_child, rfp)
                        rfp = rfp + str_len(rf_fname)
                        rfp = skip_ws(rf_child, rfp)
                        if str_eq(rf_fname, "strategy") {
                            let rf_val = child_at(rf_child, rfp)
                            let rfv_tag = node_tag(rf_val, 0)
                            if str_eq(rfv_tag, "ident") {
                                let rfvp = after_tag(rf_val, 0)
                                rfvp = skip_ws(rf_val, rfvp)
                                rtr_strat = read_word(rf_val, rfvp)
                            } else if str_eq(rfv_tag, "string") {
                                let rfvp2 = after_tag(rf_val, 0)
                                rfvp2 = skip_ws(rf_val, rfvp2)
                                rtr_strat = read_quoted(rf_val, rfvp2)
                            }
                        } else if str_eq(rf_fname, "fallback") {
                            let rf_val2 = child_at(rf_child, rfp)
                            let rfv2_tag = node_tag(rf_val2, 0)
                            if str_eq(rfv2_tag, "string") {
                                let rfv2p = after_tag(rf_val2, 0)
                                rfv2p = skip_ws(rf_val2, rfv2p)
                                rtr_fallback = read_quoted(rf_val2, rfv2p)
                            } else if str_eq(rfv2_tag, "ident") {
                                let rfv2p2 = after_tag(rf_val2, 0)
                                rfv2p2 = skip_ws(rf_val2, rfv2p2)
                                rtr_fallback = read_word(rf_val2, rfv2p2)
                            }
                        }
                    } else if str_eq(rf_tag, "rule") {
                        // (rule "tier" model)
                        let rrp = after_tag(rf_child, 0)
                        rrp = skip_ws(rf_child, rrp)
                        let rr_tier = ""
                        if char_code(char_at(rf_child, rrp)) == 34 {
                            rr_tier = read_quoted(rf_child, rrp)
                            rrp = skip_quoted(rf_child, rrp)
                        } else {
                            rr_tier = read_word(rf_child, rrp)
                            rrp = rrp + str_len(rr_tier)
                        }
                        rrp = skip_ws(rf_child, rrp)
                        let rr_model_node = child_at(rf_child, rrp)
                        let rrm_tag = node_tag(rr_model_node, 0)
                        let rr_model = ""
                        if str_eq(rrm_tag, "ident") {
                            let rrmp = after_tag(rr_model_node, 0)
                            rrmp = skip_ws(rr_model_node, rrmp)
                            rr_model = read_word(rr_model_node, rrmp)
                        } else if str_eq(rrm_tag, "string") {
                            let rrmp2 = after_tag(rr_model_node, 0)
                            rrmp2 = skip_ws(rr_model_node, rrmp2)
                            rr_model = read_quoted(rr_model_node, rrmp2)
                        } else {
                            rr_model = rr_model_node
                        }
                        sb_append(rtr_rules, rr_tier)
                        sb_append(rtr_rules, "\t")
                        sb_append(rtr_rules, rr_model)
                        sb_append(rtr_rules, "\n")
                    }
                }
                // Emit select function
                sb_append(out, "static LcnString lcn_router_")
                sb_append(out, rtr_name)
                sb_append(out, "_select(Router_")
                sb_append(out, rtr_name)
                sb_append(out, " *self, LcnString tier) {\n")
                sb_append(out, "    (void)self;\n")
                // Emit tier checks
                let rr_str = sb_to_string(rtr_rules)
                let rrp2 = 0
                let rrlen = str_len(rr_str)
                let rr_first = true
                for _rr in 0..100 {
                    if rrp2 >= rrlen { break }
                    let rrnl = str_find(str_slice(rr_str, rrp2, rrlen), "\n")
                    if rrnl < 0 { break }
                    let rr_line = str_slice(rr_str, rrp2, rrp2 + rrnl)
                    rrp2 = rrp2 + rrnl + 1
                    let rr_tab = str_find(rr_line, "\t")
                    if rr_tab >= 0 {
                        let rr_t = str_slice(rr_line, 0, rr_tab)
                        let rr_m = str_slice(rr_line, rr_tab + 1, str_len(rr_line))
                        sb_append(out, "    ")
                        if rr_first == false {
                            sb_append(out, "else ")
                        }
                        sb_append(out, "if (strcmp(tier, \"")
                        sb_append(out, rr_t)
                        sb_append(out, "\") == 0) return \"")
                        sb_append(out, rr_m)
                        sb_append(out, "\";\n")
                        rr_first = false
                    }
                }
                if str_len(rtr_fallback) > 0 {
                    sb_append(out, "    return \"")
                    sb_append(out, rtr_fallback)
                    sb_append(out, "\"; /* fallback */\n")
                } else {
                    sb_append(out, "    return \"\"; /* no matching tier */\n")
                }
                sb_append(out, "}\n\n")
                // Emit constructor
                sb_append(out, "static Router_")
                sb_append(out, rtr_name)
                sb_append(out, " lcn_router_")
                sb_append(out, rtr_name)
                sb_append(out, "_new(void) {\n")
                sb_append(out, "    return (Router_")
                sb_append(out, rtr_name)
                sb_append(out, "){ .strategy = \"")
                sb_append(out, rtr_strat)
                sb_append(out, "\", .fallback = \"")
                sb_append(out, rtr_fallback)
                sb_append(out, "\" };\n")
                sb_append(out, "}\n\n")
            } else if str_eq(dtag, "use") {
                // (use kind "url" alias) — handle a2a, mcp, etc.
                let use_p = after_tag(decl, 0)
                use_p = skip_ws(decl, use_p)
                let use_kind = read_word(decl, use_p)
                use_p = use_p + str_len(use_kind)
                use_p = skip_ws(decl, use_p)
                if str_eq(use_kind, "a2a") {
                    // (use a2a "url" alias)
                    let a2a_url = ""
                    let udlen = str_len(decl)
                    if use_p < udlen {
                        if char_code(char_at(decl, use_p)) == 34 {
                            a2a_url = read_quoted(decl, use_p)
                            use_p = skip_quoted(decl, use_p)
                        } else {
                            a2a_url = read_word(decl, use_p)
                            use_p = use_p + str_len(a2a_url)
                        }
                    }
                    use_p = skip_ws(decl, use_p)
                    let a2a_alias = "a2a"
                    if use_p < udlen {
                        let a2a_an = read_word(decl, use_p)
                        if str_len(a2a_an) > 0 {
                            if char_code(char_at(a2a_an, 0)) != 41 {
                                a2a_alias = a2a_an
                            }
                        }
                    }
                    sb_append(out, "/* A2A import: ")
                    sb_append(out, a2a_url)
                    sb_append(out, " */\n")
                    sb_append(out, "static const char *_a2a_")
                    sb_append(out, a2a_alias)
                    sb_append(out, "_url = \"")
                    sb_append(out, a2a_url)
                    sb_append(out, "\";\n")
                    sb_append(out, "static LcnA2AClient *_a2a_")
                    sb_append(out, a2a_alias)
                    sb_append(out, "_client = NULL;\n\n")
                    // Connect function
                    sb_append(out, "static LcnA2AClient *lcn_a2a_")
                    sb_append(out, a2a_alias)
                    sb_append(out, "_connect(void) {\n")
                    sb_append(out, "    if (!_a2a_")
                    sb_append(out, a2a_alias)
                    sb_append(out, "_client) {\n")
                    sb_append(out, "        _a2a_")
                    sb_append(out, a2a_alias)
                    sb_append(out, "_client = lcn_a2a_connect(_a2a_")
                    sb_append(out, a2a_alias)
                    sb_append(out, "_url);\n")
                    sb_append(out, "    }\n")
                    sb_append(out, "    return _a2a_")
                    sb_append(out, a2a_alias)
                    sb_append(out, "_client;\n")
                    sb_append(out, "}\n\n")
                    // Send wrapper
                    sb_append(out, "static LcnString lcn_a2a_")
                    sb_append(out, a2a_alias)
                    sb_append(out, "_send(LcnString message) {\n")
                    sb_append(out, "    LcnA2AClient *c = lcn_a2a_")
                    sb_append(out, a2a_alias)
                    sb_append(out, "_connect();\n")
                    sb_append(out, "    if (!c) return \"\";\n")
                    sb_append(out, "    char *r = lcn_a2a_send(c, message);\n")
                    sb_append(out, "    return r ? r : \"\";\n")
                    sb_append(out, "}\n\n")
                    // Send task wrapper
                    sb_append(out, "static LcnString lcn_a2a_")
                    sb_append(out, a2a_alias)
                    sb_append(out, "_send_task(LcnString task_json) {\n")
                    sb_append(out, "    LcnA2AClient *c = lcn_a2a_")
                    sb_append(out, a2a_alias)
                    sb_append(out, "_connect();\n")
                    sb_append(out, "    if (!c) return \"\";\n")
                    sb_append(out, "    char *r = lcn_a2a_send_task(c, task_json);\n")
                    sb_append(out, "    return r ? r : \"\";\n")
                    sb_append(out, "}\n\n")
                    // Disconnect wrapper
                    sb_append(out, "static void lcn_a2a_")
                    sb_append(out, a2a_alias)
                    sb_append(out, "_disconnect(void) {\n")
                    sb_append(out, "    if (_a2a_")
                    sb_append(out, a2a_alias)
                    sb_append(out, "_client) { lcn_a2a_disconnect(_a2a_")
                    sb_append(out, a2a_alias)
                    sb_append(out, "_client); _a2a_")
                    sb_append(out, a2a_alias)
                    sb_append(out, "_client = NULL; }\n")
                    sb_append(out, "}\n\n")
                }
                // Other use kinds (mcp, driver, model) left as comments
            } else if str_eq(dtag, "comptime") {
                // Top-level comptime block: evaluate at compile time
                // Stage 1 simplified: emit as comment
                sb_append(out, "/* comptime block evaluated at compile time */\n")
            }
            // struct/enum/use/etc already handled in pass 1
        }
    }

    // Emit main wrapper
    sb_append(out, emit_main_wrapper(has_main, main_ret_type))

    sb_to_string(out)
}

// ── Entry Point ─────────────────────────────────────────────

fn main() -> Result {
    let input_path = env("CODEGEN_INPUT")
    ensure str_len(input_path) > 0, "Set CODEGEN_INPUT to the AST file from the parser"

    let ast_str = read_file(input_path)
    ensure str_len(ast_str) > 0, "Could not read AST file or file is empty"

    // Strip the parser header lines (everything before the first "(program")
    let prog_start = str_find(ast_str, "(program")
    if prog_start < 0 {
        prog_start = 0
    }
    let ast = str_slice(ast_str, prog_start, str_len(ast_str))

    // Strip trailing "----" footer if present
    let footer = str_find(ast, "\n----")
    if footer > 0 {
        ast = str_slice(ast, 0, footer)
    }

    // Generate C code
    let c_code = emit_program(ast)

    // Output — arg(0) is program name, arg(1) is first user argument
    if arg_count() > 1 {
        let out_path = arg(1)
        write_file(out_path, c_code)
        println("codegen: wrote " + out_path)
    } else {
        println(c_code)
    }
}
