// stage1/codegen.lceron
// Limceron Code Generator — Written in Limceron (self-hosting, Stage 1)
//
// Third piece of the self-hosting compiler. Takes S-expression AST
// (from parser.lceron) and emits C99 code that compiles with gcc/clang.
//
// Usage:
//   ./build/limceron-stage0 build stage1/codegen.lceron -o build/limceron-codegen
//   CODEGEN_INPUT=ast.txt ./build/limceron-codegen [output.c]
//
// Or via pipe from parser:
//   LEX_FILE=foo.lceron ./build/limceron-parser > /tmp/ast.txt
//   CODEGEN_INPUT=/tmp/ast.txt ./build/limceron-codegen /tmp/foo.c
//
// Design:
//   - Input is S-expression string from parser (via file from env var)
//   - Walks S-expressions using str_find/str_slice/char_at (same pattern as parser)
//   - Emits C code into a StringBuilder (sb_new/sb_append/sb_to_string)
//   - String variable tracking for concat detection (parallel array)
//   - Indentation tracking via int counter
//
// Language constraints (Stage 0 compiler subset):
//   - } else if must be on same line (ASI)
//   - Vecs cannot be passed to functions — use string-encoded data
//   - No structs — use parallel arrays and globals
//   - Bounded for loops only (for x in 0..N)

// ── String Variable Tracking ────────────────────────────────
// We track which variables hold strings so we can detect
// string concatenation (+ between strings → lcn_str_concat).
// Stored as a single string: "var1\nvar2\nvar3\n"

fn is_string_var(svars: string, name: string) -> bool {
    let r = false
    if str_len(name) == 0 {
        r = false
    } else {
        let needle = name + "\n"
        let slen = str_len(svars)
        let search_from = 0
        for _isv in 0..1000 {
            if r { break }
            if search_from >= slen { break }
            let remainder = str_slice(svars, search_from, slen)
            let idx = str_find(remainder, needle)
            if idx < 0 { break }
            let abs_idx = search_from + idx
            // Make sure it's at start of line (abs_idx==0 or preceded by \n)
            if abs_idx == 0 {
                r = true
            } else {
                let prev = char_at(svars, abs_idx - 1)
                if char_code(prev) == 10 {
                    r = true
                }
            }
            search_from = abs_idx + 1
        }
    }
    r
}

fn add_string_var(svars: string, name: string) -> string {
    svars + name + "\n"
}

// ── Closure Counter in svars ────────────────────────────────
// We encode the next closure ID in svars as "<<CLO>>N\n".
// get_closure_id extracts N; set/bump_closure_id update it.

fn get_closure_id(svars: string) -> int {
    let r = 0
    let idx = str_find(svars, "<<CLO>>")
    if idx >= 0 {
        let start = idx + 7
        let slen = str_len(svars)
        let end = start
        for _gc in 0..20 {
            if end >= slen { break }
            let c = char_code(char_at(svars, end))
            if c == 10 { break }
            end = end + 1
        }
        if end > start {
            r = to_int(str_slice(svars, start, end))
        }
    }
    r
}

fn set_closure_id(svars: string, id: int) -> string {
    let idx = str_find(svars, "<<CLO>>")
    let r = ""
    if idx >= 0 {
        let start = idx
        let slen = str_len(svars)
        let end = idx + 7
        for _sc in 0..20 {
            if end >= slen { break }
            let c = char_code(char_at(svars, end))
            if c == 10 { end = end + 1; break }
            end = end + 1
        }
        let prefix = str_slice(svars, 0, start)
        let suffix = str_slice(svars, end, slen)
        r = prefix + "<<CLO>>" + to_string(id) + "\n" + suffix
    } else {
        r = svars + "<<CLO>>" + to_string(id) + "\n"
    }
    r
}

fn bump_closure_id(svars: string) -> string {
    let id = get_closure_id(svars)
    set_closure_id(svars, id + 1)
}

// ── S-Expression Navigation ─────────────────────────────────
// The AST is a flat S-expression string. These helpers extract
// node types and children by character-level parsing.

// Skip whitespace at position
fn skip_ws(s: string, pos: int) -> int {
    let p = pos
    let slen = str_len(s)
    for _w in 0..100000 {
        if p >= slen { break }
        let c = char_code(char_at(s, p))
        if c == 32 { p = p + 1
        } else if c == 10 { p = p + 1
        } else if c == 9 { p = p + 1
        } else if c == 13 { p = p + 1
        } else { break }
    }
    p
}

// Read a word (non-whitespace, non-paren) starting at pos
fn read_word(s: string, pos: int) -> string {
    let slen = str_len(s)
    let start = pos
    let p = pos
    for _w in 0..10000 {
        if p >= slen { break }
        let c = char_code(char_at(s, p))
        if c == 32 { break
        } else if c == 10 { break
        } else if c == 9 { break
        } else if c == 40 { break
        } else if c == 41 { break
        } else { p = p + 1 }
    }
    str_slice(s, start, p)
}

// Read a quoted string starting at pos (which points to the opening ")
// Returns the string content (without quotes), preserving escape sequences
fn read_quoted(s: string, pos: int) -> string {
    let slen = str_len(s)
    let p = pos + 1
    let sb = sb_new()
    for _q in 0..100000 {
        if p >= slen { break }
        let c = char_code(char_at(s, p))
        if c == 34 { break
        } else if c == 92 {
            // backslash escape — preserve both backslash and escaped char
            sb_append(sb, char_at(s, p))
            if p + 1 < slen {
                sb_append(sb, char_at(s, p + 1))
                p = p + 2
            } else {
                p = p + 1
            }
        } else {
            sb_append(sb, char_at(s, p))
            p = p + 1
        }
    }
    sb_to_string(sb)
}

// Find the end of a quoted string, returns position after closing "
fn skip_quoted(s: string, pos: int) -> int {
    let slen = str_len(s)
    let p = pos + 1
    for _q in 0..100000 {
        if p >= slen { break }
        let c = char_code(char_at(s, p))
        if c == 34 {
            p = p + 1
            break
        } else if c == 92 {
            p = p + 2
        } else {
            p = p + 1
        }
    }
    p
}

// Find matching close paren for open paren at pos
fn match_paren(s: string, pos: int) -> int {
    let slen = str_len(s)
    let depth = 0
    let p = pos
    for _mp in 0..500000 {
        if p >= slen { break }
        let c = char_code(char_at(s, p))
        if c == 40 {
            depth = depth + 1
            p = p + 1
        } else if c == 41 {
            depth = depth - 1
            if depth == 0 {
                p = p + 1
                break
            }
            p = p + 1
        } else if c == 34 {
            p = skip_quoted(s, p)
        } else {
            p = p + 1
        }
    }
    p
}

// Get the node tag: given "(tag ...)" returns "tag"
fn node_tag(s: string, pos: int) -> string {
    let slen = str_len(s)
    let p = skip_ws(s, pos)
    let r = ""
    if p < slen {
        if char_code(char_at(s, p)) == 40 {
            p = p + 1
            p = skip_ws(s, p)
            r = read_word(s, p)
        }
    }
    r
}

// Get position after the tag inside a node
fn after_tag(s: string, pos: int) -> int {
    let slen = str_len(s)
    let p = skip_ws(s, pos)
    if p < slen {
        if char_code(char_at(s, p)) == 40 {
            p = p + 1
            p = skip_ws(s, p)
            let w = read_word(s, p)
            p = p + str_len(w)
        }
    }
    p
}

// Extract a child sub-expression starting at pos (skipping whitespace)
// Returns the slice containing the full child (handles nesting)
fn child_at(s: string, pos: int) -> string {
    let slen = str_len(s)
    let p = skip_ws(s, pos)
    let r = ""
    if p >= slen {
        r = ""
    } else {
        let c = char_code(char_at(s, p))
        if c == 40 {
            let end = match_paren(s, p)
            r = str_slice(s, p, end)
        } else if c == 34 {
            let end = skip_quoted(s, p)
            r = str_slice(s, p, end)
        } else if c == 41 {
            r = ""
        } else {
            let w = read_word(s, p)
            r = w
        }
    }
    r
}

// Skip over a child expression, returns position after it
fn skip_child(s: string, pos: int) -> int {
    let slen = str_len(s)
    let p = skip_ws(s, pos)
    let r = p
    if p >= slen {
        r = p
    } else {
        let c = char_code(char_at(s, p))
        if c == 40 {
            r = match_paren(s, p)
        } else if c == 34 {
            r = skip_quoted(s, p)
        } else if c == 41 {
            r = p
        } else {
            let w = read_word(s, p)
            r = p + str_len(w)
        }
    }
    r
}

// ── Indentation Helper ──────────────────────────────────────

fn emit_indent(sb: string, level: int) -> string {
    let r = sb
    for _i in 0..20 {
        if _i >= level { break }
        r = r + "    "
    }
    r
}

// ── Type Mapping ────────────────────────────────────────────

fn map_type(ty: string) -> string {
    let r = "int64_t"
    if str_eq(ty, "int") { r = "int64_t"
    } else if str_eq(ty, "i64") { r = "int64_t"
    } else if str_eq(ty, "i32") { r = "int32_t"
    } else if str_eq(ty, "i16") { r = "int16_t"
    } else if str_eq(ty, "i8") { r = "int8_t"
    } else if str_eq(ty, "u64") { r = "uint64_t"
    } else if str_eq(ty, "u32") { r = "uint32_t"
    } else if str_eq(ty, "u16") { r = "uint16_t"
    } else if str_eq(ty, "u8") { r = "uint8_t"
    } else if str_eq(ty, "float") { r = "double"
    } else if str_eq(ty, "f64") { r = "double"
    } else if str_eq(ty, "f32") { r = "float"
    } else if str_eq(ty, "bool") { r = "bool"
    } else if str_eq(ty, "string") { r = "LcnString"
    } else if str_eq(ty, "String") { r = "LcnString"
    } else if str_eq(ty, "Result") { r = "LcnResult"
    } else if str_eq(ty, "void") { r = "void"
    } else if str_eq(ty, "Vec") { r = "LcnVec"
    } else if str_eq(ty, "List") { r = "LcnVec"
    } else if str_eq(ty, "Option") { r = "LcnOption"
    } else if str_eq(ty, "secret") { r = "LcnString"
    } else if str_eq(ty, "LcnClosure") { r = "LcnClosure"
    } else if str_len(ty) > 0 {
        // User-defined type: pass through
        r = ty
    }
    r
}

// ── Type Expression Resolution ──────────────────────────────
// Resolves S-expression type nodes like (type_named string),
// (type_secret (type_named string)), (type_named Result (generics ...))

fn resolve_type_expr(ty_node: string) -> string {
    let tag = node_tag(ty_node, 0)
    let r = "int64_t"
    if str_eq(tag, "type_named") {
        let p = after_tag(ty_node, 0)
        p = skip_ws(ty_node, p)
        let name = read_word(ty_node, p)
        // Generic args are present but we just emit the base type for now
        r = map_type(name)
    } else if str_eq(tag, "type_secret") {
        // secret T -> same C type as T (compile-time only annotation)
        let p = after_tag(ty_node, 0)
        p = skip_ws(ty_node, p)
        let inner = child_at(ty_node, p)
        if str_len(inner) > 0 {
            r = resolve_type_expr(inner)
        } else {
            r = "LcnString"
        }
    } else if str_eq(tag, "type_tainted") {
        // tainted T -> Tainted_<T>
        let p = after_tag(ty_node, 0)
        p = skip_ws(ty_node, p)
        let inner = child_at(ty_node, p)
        r = "Tainted_" + resolve_type_expr(inner)
    } else if str_eq(tag, "type_optional") {
        let p = after_tag(ty_node, 0)
        p = skip_ws(ty_node, p)
        let inner = child_at(ty_node, p)
        r = resolve_type_expr(inner)
    } else if str_eq(tag, "type_ref") {
        let p = after_tag(ty_node, 0)
        p = skip_ws(ty_node, p)
        let inner = child_at(ty_node, p)
        r = resolve_type_expr(inner) + " *"
    } else if str_len(tag) > 0 {
        // Fall back to treating it as a simple type name
        r = map_type(tag)
    }
    r
}

// ── Defense-in-Depth: sensitive call detection ──────────────
// Returns true if the function name is a sensitive call that
// should be wrapped with capability checks inside agent methods.

fn is_sensitive(fname: string) -> bool {
    let r = false
    if str_eq(fname, "http_get") { r = true
    } else if str_eq(fname, "http_post") { r = true
    } else if str_eq(fname, "http_put") { r = true
    } else if str_eq(fname, "http_delete") { r = true
    } else if str_eq(fname, "read_file") { r = true
    } else if str_eq(fname, "write_file") { r = true
    } else if str_eq(fname, "execute") { r = true
    } else if str_eq(fname, "shell") { r = true
    } else if str_eq(fname, "shell_exec") { r = true
    } else if str_eq(fname, "db_query") { r = true
    } else if str_eq(fname, "db_execute") { r = true
    } else if str_eq(fname, "send") { r = true
    } else if str_eq(fname, "send_message") { r = true
    } else if str_eq(fname, "fetch") { r = true
    } else if str_eq(fname, "exec") { r = true
    }
    r
}

// ── Check if expression might be a string ───────────────────
// Used for string concat detection. Takes the S-expr node as string.

fn might_be_string(svars: string, node: string) -> bool {
    let tag = node_tag(node, 0)
    let r = false
    if str_eq(tag, "string") {
        r = true
    } else if str_eq(tag, "call") {
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let fname = read_word(node, p)
        if str_eq(fname, "to_string") { r = true
        } else if str_eq(fname, "env") { r = true
        } else if str_eq(fname, "env_or") { r = true
        } else if str_eq(fname, "read_file") { r = true
        } else if str_eq(fname, "read_line") { r = true
        } else if str_eq(fname, "str_slice") { r = true
        } else if str_eq(fname, "str_replace") { r = true
        } else if str_eq(fname, "str_trim") { r = true
        } else if str_eq(fname, "char_at") { r = true
        } else if str_eq(fname, "str_from_code") { r = true
        } else if str_eq(fname, "format") { r = true
        } else if str_eq(fname, "format_timestamp") { r = true
        } else if str_eq(fname, "json_get") { r = true
        } else if str_eq(fname, "json_stringify") { r = true
        } else if str_eq(fname, "unwrap") { r = true
        } else if str_eq(fname, "sql_escape") { r = true
        } else if str_eq(fname, "sb_to_string") { r = true
        } else if str_eq(fname, "vec_get") { r = true
        } else if str_eq(fname, "arg") { r = true
        } else if str_eq(fname, "secret_redact") { r = true
        } else if str_eq(fname, "secret_unwrap") { r = true
        } else if str_eq(fname, "sb_peek") { r = true
        } else if str_eq(fname, "str_substring") { r = true
        } else {
            // Check if user-defined function returns string (tracked in svars as "fn:name\n")
            let fn_needle = "fn:" + fname + "\n"
            if str_find(svars, fn_needle) >= 0 {
                r = true
            }
        }
    } else if str_eq(tag, "field") {
        // (field obj fieldname) — .content on LlmOutput is a string
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let obj = child_at(node, p)
        p = skip_child(node, p)
        p = skip_ws(node, p)
        let fld = read_word(node, p)
        if str_eq(fld, "content") {
            r = true
        }
    } else if str_eq(tag, "method") {
        // (method obj methodname args...) — some methods return strings
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let obj = child_at(node, p)
        p = skip_child(node, p)
        p = skip_ws(node, p)
        let mname = read_word(node, p)
        if str_eq(mname, "call") { r = true
        } else if str_eq(mname, "to_string") { r = true
        } else if str_eq(mname, "trim") { r = true
        } else if str_eq(mname, "replace") { r = true
        }
    } else if str_eq(tag, "ident") {
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let vname = read_word(node, p)
        r = is_string_var(svars, vname)
    } else if str_eq(tag, "+") {
        // Recursive: check left and right
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let left = child_at(node, p)
        p = skip_child(node, p)
        p = skip_ws(node, p)
        let right = child_at(node, p)
        if might_be_string(svars, left) {
            r = true
        } else if might_be_string(svars, right) {
            r = true
        }
    } else if str_eq(tag, "ask") {
        r = true
    }
    r
}

// ── Infer C type from expression ────────────────────────────

fn infer_type(svars: string, node: string) -> string {
    let tag = node_tag(node, 0)
    let r = "int64_t"
    if str_eq(tag, "int") {
        r = "int64_t"
    } else if str_eq(tag, "float") {
        r = "double"
    } else if str_eq(tag, "string") {
        r = "LcnString"
    } else if str_eq(tag, "bool") {
        r = "bool"
    } else if str_eq(tag, "none") {
        r = "void *"
    } else if str_eq(tag, "call") {
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let fname = read_word(node, p)
        // Builtins that return string
        if str_eq(fname, "to_string") { r = "LcnString"
        } else if str_eq(fname, "env") { r = "LcnString"
        } else if str_eq(fname, "env_or") { r = "LcnString"
        } else if str_eq(fname, "read_file") { r = "LcnString"
        } else if str_eq(fname, "read_line") { r = "LcnString"
        } else if str_eq(fname, "str_slice") { r = "LcnString"
        } else if str_eq(fname, "str_replace") { r = "LcnString"
        } else if str_eq(fname, "str_trim") { r = "LcnString"
        } else if str_eq(fname, "char_at") { r = "LcnString"
        } else if str_eq(fname, "str_from_code") { r = "LcnString"
        } else if str_eq(fname, "format") { r = "LcnString"
        } else if str_eq(fname, "format_timestamp") { r = "LcnString"
        } else if str_eq(fname, "json_get") { r = "LcnString"
        } else if str_eq(fname, "json_stringify") { r = "LcnString"
        } else if str_eq(fname, "unwrap") { r = "LcnString"
        } else if str_eq(fname, "sql_escape") { r = "LcnString"
        } else if str_eq(fname, "sb_to_string") { r = "LcnString"
        } else if str_eq(fname, "vec_get") { r = "LcnString"
        } else if str_eq(fname, "arg") { r = "LcnString"
        } else if str_eq(fname, "str_substring") { r = "LcnString"
        // Builtins that return int
        } else if str_eq(fname, "str_len") { r = "int64_t"
        } else if str_eq(fname, "str_find") { r = "int64_t"
        } else if str_eq(fname, "char_code") { r = "int64_t"
        } else if str_eq(fname, "to_int") { r = "int64_t"
        } else if str_eq(fname, "len") { r = "int64_t"
        } else if str_eq(fname, "now_ms") { r = "int64_t"
        } else if str_eq(fname, "arg_count") { r = "int64_t"
        } else if str_eq(fname, "vec_len") { r = "int64_t"
        // Builtins that return bool
        } else if str_eq(fname, "str_eq") { r = "bool"
        } else if str_eq(fname, "contains") { r = "bool"
        } else if str_eq(fname, "starts_with") { r = "bool"
        } else if str_eq(fname, "ends_with") { r = "bool"
        } else if str_eq(fname, "str_char_is_alpha") { r = "bool"
        } else if str_eq(fname, "str_char_is_digit") { r = "bool"
        } else if str_eq(fname, "str_char_is_alnum") { r = "bool"
        } else if str_eq(fname, "write_file") { r = "bool"
        // Builtins that return void*
        } else if str_eq(fname, "sb_new") { r = "void *"
        } else if str_eq(fname, "vec_new") { r = "LcnVec"
        // JSON
        } else if str_eq(fname, "json_parse") { r = "LcnJsonValue *"
        } else if str_eq(fname, "json_array_get") { r = "LcnJsonValue *"
        } else if str_eq(fname, "json_array_len") { r = "int64_t"
        } else if str_eq(fname, "json_get_number") { r = "double"
        } else if str_eq(fname, "sb_peek") { r = "LcnString"
        } else if str_eq(fname, "secret_redact") { r = "LcnString"
        } else if str_eq(fname, "secret_unwrap") { r = "LcnString"
        } else {
            // Check if user-defined function returns string (tracked in svars as "fn:name\n")
            let fn_needle = "fn:" + fname + "\n"
            if str_find(svars, fn_needle) >= 0 {
                r = "LcnString"
            } else {
                // Default for unknown user-defined function: int64_t
                r = "int64_t"
            }
        }
    } else if str_eq(tag, "closure") {
        r = "LcnClosure"
    } else if str_eq(tag, "ask") {
        r = "LcnLlmOutput"
    } else if str_eq(tag, "field") {
        // (field obj fieldname) — .content on LlmOutput is a string
        let fp = after_tag(node, 0)
        fp = skip_ws(node, fp)
        let fobj = child_at(node, fp)
        fp = skip_child(node, fp)
        fp = skip_ws(node, fp)
        let fld = read_word(node, fp)
        if str_eq(fld, "content") {
            r = "LcnString"
        }
    } else if str_eq(tag, "method") {
        // (method obj methodname args...) — some methods return strings
        let mp = after_tag(node, 0)
        mp = skip_ws(node, mp)
        let mobj = child_at(node, mp)
        mp = skip_child(node, mp)
        mp = skip_ws(node, mp)
        let mname = read_word(node, mp)
        if str_eq(mname, "call") { r = "LcnString"
        } else if str_eq(mname, "to_string") { r = "LcnString"
        } else if str_eq(mname, "trim") { r = "LcnString"
        } else if str_eq(mname, "replace") { r = "LcnString"
        }
    } else if str_eq(tag, "ident") {
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        let vname = read_word(node, p)
        if is_string_var(svars, vname) {
            r = "LcnString"
        } else {
            r = "int64_t"
        }
    } else if str_eq(tag, "+") {
        if might_be_string(svars, node) {
            r = "LcnString"
        } else {
            r = "int64_t"
        }
    } else if str_eq(tag, "-") { r = "int64_t"
    } else if str_eq(tag, "*") { r = "int64_t"
    } else if str_eq(tag, "/") { r = "int64_t"
    } else if str_eq(tag, "==") { r = "bool"
    } else if str_eq(tag, "!=") { r = "bool"
    } else if str_eq(tag, "<") { r = "bool"
    } else if str_eq(tag, ">") { r = "bool"
    } else if str_eq(tag, "<=") { r = "bool"
    } else if str_eq(tag, ">=") { r = "bool"
    } else if str_eq(tag, "array") { r = "LcnVec"
    } else if str_eq(tag, "map") {
        // (map TypeName ...) — struct initialization
        let p = after_tag(node, 0)
        p = skip_ws(node, p)
        r = read_word(node, p)
    } else if str_eq(tag, "try_otherwise") { r = "LcnLlmOutput"
    } else if str_eq(tag, "keep_where") { r = "int"
    } else if str_eq(tag, "each") { r = "int"
    } else if str_eq(tag, "tell") { r = "void"
    } else if str_eq(tag, "channel") { r = "LcnChannel *"
    } else if str_eq(tag, "spawn") { r = "void"
    } else if str_eq(tag, "await") { r = "void *"
    } else if str_eq(tag, "select") { r = "int"
    } else if str_eq(tag, "deref") { r = "int64_t"
    } else if str_eq(tag, "ref") { r = "int64_t"
    } else if str_eq(tag, "index") { r = "int64_t"
    } else if str_eq(tag, "range") { r = "int64_t"
    } else if str_eq(tag, "tuple") { r = "int64_t"
    } else if str_eq(tag, "unary") { r = "int64_t"
    } else if str_eq(tag, "pipe") {
        r = "int64_t"
    }
    r
}

// ── Builtin Detection ───────────────────────────────────────

fn is_builtin(name: string) -> bool {
    let r = false
    if str_eq(name, "print") { r = true
    } else if str_eq(name, "println") { r = true
    } else if str_eq(name, "len") { r = true
    } else if str_eq(name, "contains") { r = true
    } else if str_eq(name, "starts_with") { r = true
    } else if str_eq(name, "ends_with") { r = true
    } else if str_eq(name, "env") { r = true
    } else if str_eq(name, "env_or") { r = true
    } else if str_eq(name, "str_eq") { r = true
    } else if str_eq(name, "str_replace") { r = true
    } else if str_eq(name, "str_trim") { r = true
    } else if str_eq(name, "str_substring") { r = true
