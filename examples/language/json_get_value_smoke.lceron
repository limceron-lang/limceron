// json_get_value_smoke.lceron — proof-of-concept for the json_get_value
// builtin. Native target (Stage 0, no WASM). Synthetic fixture only.
//
// Demonstrates a common "merge an incoming JSON document over a base
// document" pattern: per top-level field, if the incoming value is
// non-empty, it wins; otherwise the base value is kept (the JSON
// equivalent of `for k, v in incoming.items(): if v: base[k] = v`).
// Exercises the three field shapes that matter for this: a plain
// string, a list[str], and a list[struct].
//
// Written as independent if/else branches, each with its own println —
// NOT `let x = if cond {a} else {b}` (block-bodied if-as-expression hits
// an unimplemented codegen path in the C99 backend) and NOT `let mut x:
// Json = ...` (explicit `Json` type annotations aren't handled by cg_type
// either). Both are separate findings, reported alongside this file —
// this program only exercises json_get_value itself.

fn main() {
    let base = json_parse(
        "{\"summary\":\"base summary\",\"tags\":[\"draft\",\"internal\"],\"members\":[{\"name\":\"alice\",\"role\":\"lead\"}]}")
    let incoming = json_parse(
        "{\"summary\":\"updated summary\",\"tags\":[],\"members\":[{\"name\":\"bob\",\"role\":\"reviewer\"},{\"name\":\"alice\",\"role\":\"lead\"}]}")

    // Simple string field ("summary"): json_get already covers this
    // (returns string directly) — incoming has content, so it wins.
    let incoming_summary = json_get(incoming, "summary")
    if str_eq(incoming_summary, "") {
        println("summary (expect: incoming, has content) -> " + json_get(base, "summary"))
    } else {
        println("summary (expect: incoming, has content) -> " + incoming_summary)
    }

    // list[str] field ("tags"): incoming is an EMPTY array -> keep base.
    // This is exactly the case json_get can't handle (it only returns
    // string) — needs json_get_value to get the array as a Json handle.
    let incoming_tags = json_get_value(incoming, "tags")
    if json_array_len(incoming_tags) == 0 {
        println("tags (expect: base, incoming was empty) -> " + json_stringify(json_get_value(base, "tags")))
    } else {
        println("tags (expect: base, incoming was empty) -> " + json_stringify(incoming_tags))
    }

    // list[struct] field ("members"): incoming has content -> incoming
    // wins, whole sub-tree replaced wholesale (no per-element merge),
    // same as the "base[k] = v" case for a list field.
    let incoming_members = json_get_value(incoming, "members")
    if json_array_len(incoming_members) == 0 {
        println("members (expect: incoming, has content) -> " + json_stringify(json_get_value(base, "members")))
    } else {
        println("members (expect: incoming, has content) -> " + json_stringify(incoming_members))
    }
}
